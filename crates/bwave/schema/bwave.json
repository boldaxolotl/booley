{
  "$defs": {
    "clockFinding": {
      "additionalProperties": false,
      "description": "One observation about the clock; reason as in clockVerdict.reason, plus multiple_clock_periods when candidate clocks disagree (context only).",
      "properties": {
        "detail": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "reason",
        "tick",
        "detail"
      ],
      "type": "object"
    },
    "clockVerdict": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/clockFinding"
          },
          "type": "array"
        },
        "first_off_grid_cycle": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "first_off_grid_tick": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "description": "Cause of the status: regular, stopped_stretches, off_grid_edge, non_integer_period, unknown_clock or insufficient_edges. See `bwave docs show reference/sync-vs-async`.",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "unavailable"
          ]
        },
        "stopped": {
          "$ref": "#/$defs/stopSummary"
        }
      },
      "required": [
        "status",
        "reason",
        "clock",
        "first_off_grid_tick",
        "first_off_grid_cycle",
        "findings",
        "stopped"
      ],
      "type": "object"
    },
    "distanceData": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/distancePair"
          },
          "type": "array"
        },
        "stopped_cycles": {
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "unit": {
          "enum": [
            "ticks",
            "cycles"
          ]
        }
      },
      "required": [
        "unit",
        "count",
        "pairs",
        "summary",
        "stopped_cycles",
        "truncated"
      ],
      "type": "object"
    },
    "distancePair": {
      "additionalProperties": false,
      "properties": {
        "elapsed": {
          "minimum": 0,
          "type": "integer"
        },
        "from": {
          "minimum": 0,
          "type": "integer"
        },
        "stopped_cycles": {
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to",
        "elapsed",
        "stopped_cycles"
      ],
      "type": "object"
    },
    "findData": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "count_only": {
          "type": "boolean"
        },
        "first_only": {
          "type": "boolean"
        },
        "last_only": {
          "type": "boolean"
        },
        "matches": {
          "description": "Empty when `count_only`. Contains the single match when `last_only`.",
          "items": {
            "$ref": "#/$defs/findMatch"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ],
          "type": "string"
        },
        "pattern": {
          "description": "Find-target glob.",
          "type": "string"
        },
        "scope_prefix": {
          "type": "string"
        },
        "truncated": {
          "description": "True when output was capped by --limit.",
          "type": "boolean"
        },
        "unit": {
          "description": "Unit of `time` in each match. `cycle` in sync mode with a clock; `tick` otherwise.",
          "enum": [
            "cycle",
            "tick"
          ],
          "type": "string"
        },
        "value": {
          "description": "Edge keyword (`rising`, `falling`, `change`), or the literal value normalized like signalValue.value ('d255 is \"FF\").",
          "type": "string"
        }
      },
      "required": [
        "scope_prefix",
        "pattern",
        "value",
        "mode",
        "unit",
        "count",
        "matches",
        "truncated",
        "first_only",
        "last_only",
        "count_only"
      ],
      "type": "object"
    },
    "findMatch": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "time": {
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "Raw cache value (see signalValue.value).",
          "type": "string"
        }
      },
      "required": [
        "time",
        "name",
        "value"
      ],
      "type": "object"
    },
    "listData": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "description": "Full hierarchical name of the detected (or --clock-overridden) clock; null on an async trace. Trace-level, not filtered by the pattern. `bwave gui` makes it row 1 of a new view.",
          "type": [
            "string",
            "null"
          ]
        },
        "root_scopes": {
          "description": "Distinct first-level scopes represented by the matched signals. Unlike scope_prefix, this remains populated when a trace has multiple roots.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope_prefix": {
          "description": "Common hierarchical prefix of all matched signals (without trailing dot). Empty when matches span multiple scopes or are top-level.",
          "type": "string"
        },
        "signal_count": {
          "description": "Total matched signals before --limit is applied to the signals array.",
          "minimum": 0,
          "type": "integer"
        },
        "signals": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Signal name with `scope_prefix` stripped.",
                "type": "string"
              },
              "var_type": {
                "description": "VCD var type — `wire`, `reg`, `integer`, etc.",
                "type": "string"
              },
              "width": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "width",
              "var_type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "total_ticks": {
          "description": "End of the trace in file-timescale ticks — same value `stats` reports. Trace-level, not filtered by the pattern; here so an open-ended time range does not cost a full stats walk.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scope_prefix",
        "root_scopes",
        "signal_count",
        "clock",
        "total_ticks",
        "signals"
      ],
      "type": "object"
    },
    "overviewData": {
      "additionalProperties": false,
      "properties": {
        "first_rise_tick": {
          "minimum": 0,
          "type": "integer"
        },
        "period_ticks": {
          "minimum": 0,
          "type": "integer"
        },
        "signal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "total_ticks": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_ticks",
        "signal_count",
        "period_ticks",
        "first_rise_tick"
      ],
      "type": "object"
    },
    "resetReport": {
      "additionalProperties": false,
      "properties": {
        "chosen_by": {
          "description": "Whether detection or `--reset` picked the signal.",
          "enum": [
            "auto",
            "--reset"
          ]
        },
        "deassert_tick": {
          "description": "Tick where the reset's first assertion ends; null when it never asserts or never deasserts.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "deassert_time": {
          "description": "deassert_tick in the store's timescale, such as `25ns`.",
          "type": [
            "string",
            "null"
          ]
        },
        "polarity": {
          "description": "Polarity guessed from the signal's name; null without a reset.",
          "enum": [
            "active_low",
            "active_high",
            null
          ]
        },
        "signal": {
          "description": "Full name of the reset signal; null when the store has none.",
          "type": [
            "string",
            "null"
          ]
        },
        "skipped_cycles": {
          "description": "Clock cycles before the deassert that sync queries skip; 0 with --with-reset, without a clock or without a deassert.",
          "minimum": 0,
          "type": "integer"
        },
        "with_reset": {
          "description": "Whether --with-reset kept the reset phase.",
          "type": "boolean"
        }
      },
      "required": [
        "signal",
        "polarity",
        "chosen_by",
        "deassert_tick",
        "deassert_time",
        "skipped_cycles",
        "with_reset"
      ],
      "type": "object"
    },
    "signalData": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "sync",
            "async"
          ]
        },
        "records": {
          "items": {
            "$ref": "#/$defs/signalRecord"
          },
          "type": "array"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "records",
        "truncated"
      ],
      "type": "object"
    },
    "signalRecord": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "value"
            },
            "name": {
              "type": "string"
            },
            "time": {
              "minimum": 0,
              "type": "integer"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "time",
            "name",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from_cycle": {
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "clock_stopped"
            },
            "to_cycle": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "from_cycle",
            "to_cycle"
          ],
          "type": "object"
        }
      ]
    },
    "signalValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "description": "Raw store value with no Verilog-literal prefix, padding or radix formatting (a 3-bit 5 is \"5\", 0xDEADBEEF is \"DEADBEEF\"); X and Z appear literally. Hex/binary mix per store encoding. The -s %RADIX suffix does not apply to JSON.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "statsData": {
      "additionalProperties": false,
      "properties": {
        "clock_period_ns": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/statsEntry"
          },
          "type": "array"
        },
        "simulation_ns": {
          "type": "integer"
        },
        "total_cycles": {
          "description": "Null when no clock was found.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_ticks": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "simulation_ns",
        "total_ticks",
        "total_cycles",
        "clock_period_ns",
        "signals"
      ],
      "type": "object"
    },
    "statsEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "time_in_state_clocked_cycles": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "time_in_state_ns": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Same keys as `time_in_state_ticks`, values converted to ns via the cache timescale. Null when no timescale is recorded in the VCD.",
          "type": [
            "object",
            "null"
          ]
        },
        "time_in_state_stopped_cycles": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "time_in_state_ticks": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Map of Verilog-literal value -> tick count held. Renamed from `time_in_state` in v0.2.1 so the unit is unambiguous; pair with `time_in_state_ns` if you want nanoseconds.",
          "type": "object"
        },
        "toggle_pct": {
          "type": "number"
        },
        "transitions": {
          "minimum": 0,
          "type": "integer"
        },
        "value_hist": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Map of Verilog-literal value (e.g. \"'hFF\", \"'d255\", \"'b101\") -> occurrence count. Matches the text-mode display radix per signal.",
          "type": "object"
        },
        "value_pct": {
          "type": "number"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "width",
        "transitions",
        "toggle_pct",
        "value_pct",
        "value_hist",
        "time_in_state_ticks",
        "time_in_state_clocked_cycles",
        "time_in_state_stopped_cycles"
      ],
      "type": "object"
    },
    "stopSummary": {
      "additionalProperties": false,
      "properties": {
        "longest": {
          "anyOf": [
            {
              "$ref": "#/$defs/stoppedRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "stretches": {
          "minimum": 0,
          "type": "integer"
        },
        "total_cycles": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stretches",
        "total_cycles",
        "longest"
      ],
      "type": "object"
    },
    "stoppedRange": {
      "additionalProperties": false,
      "properties": {
        "from_cycle": {
          "minimum": 0,
          "type": "integer"
        },
        "to_cycle": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from_cycle",
        "to_cycle"
      ],
      "type": "object"
    },
    "valueData": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "User-supplied time argument verbatim.",
          "type": "integer"
        },
        "at_unit": {
          "description": "Unit of `at`. `cycle` in sync mode; `tick` when sync was requested but no clock was found; `ns` in async mode.",
          "enum": [
            "cycle",
            "tick",
            "ns"
          ],
          "type": "string"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ],
          "type": "string"
        },
        "sample_tick": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope_prefix": {
          "type": "string"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/signalValue"
          },
          "type": "array"
        },
        "target_tick": {
          "description": "Resolved simulation tick where the snapshot was taken.",
          "minimum": 0,
          "type": "integer"
        },
        "time_label": {
          "description": "Human label matching text mode's `# Snapshot at <label>` line.",
          "type": "string"
        }
      },
      "required": [
        "scope_prefix",
        "mode",
        "at",
        "at_unit",
        "target_tick",
        "time_label",
        "signals",
        "sample_tick"
      ],
      "type": "object"
    },
    "waveData": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ]
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ticks": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "mode",
        "columns",
        "ticks",
        "names",
        "values"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/boldaxolotl/booley/v0.5.0/crates/bwave/schema/bwave.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "list"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/listData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "value"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/valueData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "find"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/findData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "stats"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/statsData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "signal"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/signalData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "wave"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/waveData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "distance"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/distanceData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "overview"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/overviewData"
          }
        }
      }
    }
  ],
  "description": "B-Wave JSON envelope revision 2, emitted by `--format json` on list, value, find, stats, signal, wave, distance and overview; sample, diff and stuck are text-only and exit 2 on `--format json`. Clock-grid diagnostics and stopped ranges are advisory. The `reset` object reports the reset the query used. `bwave schema` prints the revision the installed binary emits.",
  "properties": {
    "$schema": {
      "description": "Immutable URL of the expanded schema revision.",
      "type": "string"
    },
    "clock_regularity": {
      "$ref": "#/$defs/clockVerdict",
      "description": "Verdict on the selected clock. Present on sync queries and on async queries that use cycle tokens; absent on async queries with only tick/time tokens. A `warning` or `unavailable` verdict is repeated in `warnings`."
    },
    "clock_stopped": {
      "description": "Present only when the query window overlaps a clock stop. Each entry is the whole stop, even when the window covers part of it, numbered on the query's reset-aware grid. Not capped by --limit.",
      "items": {
        "$ref": "#/$defs/stoppedRange"
      },
      "type": "array"
    },
    "command": {
      "description": "Which subcommand produced this envelope.",
      "enum": [
        "list",
        "value",
        "find",
        "stats",
        "signal",
        "wave",
        "distance",
        "overview"
      ],
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/listData"
        },
        {
          "$ref": "#/$defs/valueData"
        },
        {
          "$ref": "#/$defs/findData"
        },
        {
          "$ref": "#/$defs/statsData"
        },
        {
          "$ref": "#/$defs/signalData"
        },
        {
          "$ref": "#/$defs/waveData"
        },
        {
          "$ref": "#/$defs/distanceData"
        },
        {
          "$ref": "#/$defs/overviewData"
        }
      ]
    },
    "reset": {
      "$ref": "#/$defs/resetReport",
      "description": "The reset the query used and the cycles it skipped. Present on sync queries and `overview`; absent on async queries and `list`."
    },
    "warnings": {
      "description": "Diagnostics that text mode would write to stderr as `# WARNING: ...` lines, including --limit truncation. Empty on a clean run.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "command",
    "data",
    "warnings"
  ],
  "title": "B-Wave --format json envelope",
  "type": "object"
}
