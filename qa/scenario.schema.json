{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1,
      "type": "integer"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "check_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "checks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "shared_pre_run_requirements": {
      "description": "Pre-run requirements inherited by every Configured Scenario in this Scenario.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "configured_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "host_os": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "cpu_architecture": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "native_host": {
                "type": "boolean"
              },
              "agent_provider": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "interactive_mode_client": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "ticket_mode_backend": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "host_os",
              "cpu_architecture",
              "native_host",
              "agent_provider",
              "interactive_mode_client",
              "ticket_mode_backend"
            ],
            "additionalProperties": false
          },
          "pre_run_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "check_sets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "check",
                "reason"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "required",
          "parameters",
          "pre_run_requirements",
          "check_sets",
          "exclusions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "git",
              "sha256",
              "literal",
              "pre-run"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "source",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "deadline_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "cleanup_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "contingency_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480
        },
        "cleanup_start_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "final_regression_start_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        }
      },
      "required": [
        "deadline_minutes",
        "cleanup_minutes",
        "contingency_minutes",
        "cleanup_start_minutes"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480
          }
        },
        "required": [
          "id",
          "title",
          "minutes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "stimulus": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "capture": {
                  "type": "string",
                  "minLength": 1
                },
                "navigation_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "capabilities",
                "stimulus",
                "expected",
                "authority_ref",
                "evidence",
                "capture"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "authority": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480
          },
          "retry": {
            "type": "object",
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "signature": {
                "const": "API Error: Response stalled mid-stream"
              }
            },
            "required": [
              "max_attempts",
              "signature"
            ],
            "additionalProperties": false
          },
          "recovery": {
            "type": "object",
            "properties": {
              "baseline": {
                "type": "string",
                "minLength": 1
              },
              "detection": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "baseline",
              "detection",
              "instruction"
            ],
            "additionalProperties": false
          },
          "recovery_point": {
            "type": "string",
            "minLength": 1
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "audience": {
                  "enum": [
                    "scenario-operator",
                    "setup delegate",
                    "Interactive Mode delegate",
                    "Developer Agent",
                    "independent evaluator"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "substitutions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "run_root",
                      "artifact_root",
                      "ticket_id",
                      "commit_id",
                      "product_revision",
                      "provider"
                    ]
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "base": {
                  "enum": [
                    "scenario",
                    "shared"
                  ],
                  "default": "scenario",
                  "description": "Resolve path within the owning scenario or qa/shared."
                }
              },
              "required": [
                "path",
                "audience"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "phase",
          "action",
          "checks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "format_version",
    "scenario_id",
    "title",
    "source",
    "check_sets",
    "configured_scenarios",
    "inputs",
    "authority",
    "budget",
    "phases",
    "steps"
  ],
  "additionalProperties": false
}
