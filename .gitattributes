* text=auto eol=lf
# Shell scripts execute under bash/sh in the Linux Session Runtime container,
# and package-data (`tools/*.sh`, docker scripts) is copied into the wheel and
# image verbatim from the working tree. A CRLF checkout on a Windows host
# (core.autocrlf=true, the Git for Windows default) therefore ships CRLF
# scripts that bash cannot parse — `$'\r': command not found` — blocking every
# ticket run (F-12). Force LF regardless of host git config.
*.sh text eol=lf

# QA fixtures, traces, and the frozen upstream corpus are compared byte for byte.
# Checkout conversion must not rewrite those bytes.
qa/** -text

# Captured Campaign documents are authenticated by size and digest, so their
# bytes, including trailing blank lines in run logs, stay as captured.
tests/qa/fixtures/** -text -whitespace

# Captured Cocotb console output keeps the producer's trailing spaces.
tests/fixtures/cocotb_timeout_progress/2.1.0/*.log -text -whitespace

# Frozen experiment downloads retain exact bytes, including blank patch context.
website/docs/blog/posts/harness-matters/*.patch -text -whitespace
website/docs/blog/posts/harness-matters/agent-prompt.txt -text

# Many parallel PRs each append a bullet under `## Unreleased`. Union merge keeps
# both sides' added lines, so a local `git merge origin/main` no longer stops on
# a CHANGELOG conflict. The packaged mirror must stay byte-identical (tested).
# Caveat: union never reports conflicts, so it suits append-only bullet lists;
# overlapping edits to the same line can duplicate or misorder text. Review the
# merged Unreleased section.
CHANGELOG.md merge=union
src/booley/data/refs/CHANGELOG.md merge=union
