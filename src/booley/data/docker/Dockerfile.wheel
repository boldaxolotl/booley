# Generic checkout-specific wheel overlay.  BuildKit maps the symbolic parent
# to a verified standard, RISC-V, or Project substrate.
# The native B-Wave binary is compiled on a bookworm builder on purpose: its
# glibc (2.36) is older than the final image's Ubuntu 24.04 (2.39), so the
# binary's symbol requirements resolve there.  Identical to the legacy
# Dockerfile stage so BuildKit shares the cache between the two recipes.
FROM rust:1.99.0-slim-bookworm@sha256:452176c0cefca88c0b3184ce85a4eb03e3d4fa05d2afb5366abcba853221019e AS bwave-builder
COPY crates/bwave/ /build/bwave/
RUN CARGO_TARGET_DIR=/build/target cargo build --release --locked \
        --manifest-path /build/bwave/Cargo.toml

FROM booley-substrate
USER root

COPY .github/scripts/validate_installed_artifact.py /tmp/booley-build/validate_installed_artifact.py
RUN --mount=type=bind,source=dist,target=/tmp/booley-dist,readonly \
    WHEEL="$(find /tmp/booley-dist -maxdepth 1 -name 'booley_rtl-*.whl' -print -quit)" \
    && test -n "$WHEEL" \
    && test "$(find /tmp/booley-dist -maxdepth 1 -name 'booley_rtl-*.whl' | wc -l)" -eq 1 \
    && python3 -m pip install --break-system-packages --no-cache-dir --ignore-installed \
        --no-deps "$WHEEL" \
    && python3 -m pip check \
    && cd /tmp \
    && BOOLEY_CONTAINER=1 python3 /tmp/booley-build/validate_installed_artifact.py \
        --inventory /tmp/booley-installed-files.txt \
        --forbid-root /work \
        --wheel "$WHEEL" \
    && rm -f /tmp/booley-installed-files.txt \
    && test "$(python3 -m pip list --format=json | python3 -c 'import json,sys; print(sum(p["name"].lower().replace("_", "-") == "booley-rtl" for p in json.load(sys.stdin)))')" -eq 1

# Install the native binary and create its package-data hard link in this ONE
# RUN.  An exported layer diff cannot record a hard link whose other name lives
# in a lower layer, so splitting them (issue #828) stores the bytes twice or
# breaks the link outright depending on the image store.
RUN --mount=type=bind,from=bwave-builder,source=/build/target/release,target=/tmp/bwave,readonly \
    BWAVE_BIN_DIR="$(python3 -c 'from booley.runtime.paths import package_data_dir; print(package_data_dir())')/bin" \
    && mkdir -p /usr/local/libexec/booley "$BWAVE_BIN_DIR" \
    && install -m 0755 /tmp/bwave/bwave /usr/local/libexec/booley/bwave \
    && ln /usr/local/libexec/booley/bwave "$BWAVE_BIN_DIR/bwave" \
    && /usr/local/libexec/booley/bwave --version
ENV BOOLEY_BWAVE_BIN=/usr/local/libexec/booley/bwave

ARG BOOLEY_VERSION=unknown
ARG BOOLEY_SOURCE_REVISION=unknown
ARG BOOLEY_SOURCE_UPDATED_AT=unknown
ARG BOOLEY_IMAGE_BUILT_AT=unknown
ARG BOOLEY_PAYLOAD_FINGERPRINT=unknown
ARG BOOLEY_WHEEL_SHA256=unknown
ENV BOOLEY_VERSION=${BOOLEY_VERSION} \
    BOOLEY_SOURCE_REVISION=${BOOLEY_SOURCE_REVISION} \
    BOOLEY_SOURCE_UPDATED_AT=${BOOLEY_SOURCE_UPDATED_AT} \
    BOOLEY_IMAGE_BUILT_AT=${BOOLEY_IMAGE_BUILT_AT} \
    BOOLEY_PAYLOAD_FINGERPRINT=${BOOLEY_PAYLOAD_FINGERPRINT} \
    BOOLEY_WHEEL_SHA256=${BOOLEY_WHEEL_SHA256}
LABEL org.opencontainers.image.version=${BOOLEY_VERSION} \
      org.opencontainers.image.revision=${BOOLEY_SOURCE_REVISION} \
      org.opencontainers.image.created=${BOOLEY_IMAGE_BUILT_AT} \
      org.opencontainers.image.source=https://github.com/boldaxolotl/booley

RUN test -x "$(command -v claude)" \
    && python3 -c 'import booley, cocotb, edalize.tools.verible, edalize.tools.veriblelint, fusesoc; print(booley.__file__)' \
    && /usr/local/libexec/booley/bwave --version

USER root
RUN if test -e /booley-project || test -L /booley-project; then \
        test -L /booley-project && test "$(readlink /booley-project)" = /work/.booley_project; \
    else ln -s /work/.booley_project /booley-project; fi \
    && chown -h root:root /booley-project \
    && test "$(stat -c %u /)" = 0 \
    && test "$(readlink /booley-project)" = /work/.booley_project

USER agent
WORKDIR /work
