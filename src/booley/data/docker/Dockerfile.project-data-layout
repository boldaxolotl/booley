FROM booley-layout-parent
ARG BOOLEY_LAYOUT_USER=root
USER root
RUN test -L /booley \
    && test "$(readlink /booley)" = /work/.booley \
    && test "$(stat -c %u /booley)" = 0 \
    && rm /booley \
    && mkdir /booley \
    && chown root:root /booley \
    && chmod 0755 /booley
USER ${BOOLEY_LAYOUT_USER}
