# Booley standard tool substrate.  This image intentionally contains no Booley
# Python distribution: the checkout-specific wheel is installed only by the
# final Dockerfile.wheel overlay.  It also carries no native B-Wave binary: the
# binary and its package-data hard link must be created in one layer (an
# exported layer diff cannot express a link to a lower layer), and the link
# needs the wheel's install path, so Dockerfile.wheel owns both.
# BuildKit resolves this name to the exact runtime-base image via
# --build-context.  A mutable ARG ... FROM reference is never ancestry proof.
FROM booley-runtime-base
USER root

# Edalize patch (ADR 0033).
COPY src/booley/data/edalize/verible.py /tmp/booley-build/verible.py
RUN python -c 'import pathlib, shutil, edalize.tools; src = pathlib.Path("/tmp/booley-build/verible.py"); dst = pathlib.Path(list(edalize.tools.__path__)[0]); shutil.copyfile(src, dst / "verible.py"); shutil.copyfile(src, dst / "veriblelint.py")' \
    && rm -f /tmp/booley-build/verible.py

RUN echo '#!/bin/bash\nexec python3 -m booley.bwave.cli "$@"' \
    > /usr/local/bin/bwave && chmod +x /usr/local/bin/bwave

# A substrate carrying an older wheel would make a fresh overlay look current
# while stale package files remain hidden below it.  Fail that migration loudly.
RUN ! python3 -m pip show booley-rtl >/dev/null 2>&1 \
    && python3 -c 'import importlib.util; assert importlib.util.find_spec("booley") is None'

USER agent
WORKDIR /work
