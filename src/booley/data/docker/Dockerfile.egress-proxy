# Egress proxy sidecar for the Sandbox (ADR 0018).
# Build context: src/booley/docker (the repo-root .dockerignore strips src/).
FROM python:3.15.2-slim-bookworm@sha256:498829c717b1e59fc42f0e7865eafe4e04ca0f70a3769d4ae70ba218df54507c
COPY egress_proxy.py proxy_entry.py /app/
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["python", "-u", "proxy_entry.py"]
