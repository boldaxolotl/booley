# Booley RISC-V tool substrate — the standard wheel-free substrate plus a full
# RISC-V software toolchain, a reference ISS, and the ratified RISC-V
# International spec set baked in for offline use. The final wheel overlay is
# applied separately. Purpose-built for RISC-V CPU-core projects
# (ibex, picorv32, biriscv, …) whose flows compile firmware/tests with a
# RISC-V cross-compiler before simulating the RTL.
#
# Two stages (ADR 0070). `riscv-tooling` builds /opt/riscv and /opt/riscv-docs
# FROM the same digest-pinned Ubuntu image as the final stage of
# Dockerfile.base and depends on no Booley image. Its exact text is the RISC-V
# tooling key (.github/scripts/riscv_tooling.py), so any edit to it — even a
# comment — re-keys the published tooling image. Keep every ARG it uses inside
# the stage, keep it free of COPY/ADD, and declare no ARG before the first FROM.
# CI may replace this stage with a published, label-verified image through a
# same-named build context; local and release builds always build it here.
#
# BuildKit maps `booley-standard-substrate` through an explicit named context.
# Source convergence binds it to the prepared wheel-free standard substrate;
# legacy Project Initialization binds it to the verified standard Sandbox
# Image. Both adapters use a local tag as the context source and record its
# separately inspected immutable image ID as provenance. Keep this file free of
# build-context COPY/ADD (`COPY --from=riscv-tooling` is stage-internal):
# installed Booley distributions always pull the complete published image,
# while local builds use data/docker/ as their otherwise-unused context.

FROM docker.io/library/ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7 AS riscv-tooling

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Same clock-skew tolerance as Dockerfile.base: Windows/WSL2 hosts with a
# skewed clock otherwise reject fresh apt Release files. Integrity stays
# GPG-verified.
RUN printf 'Acquire::Check-Date "false";\n' > /etc/apt/apt.conf.d/99-tolerate-clock-skew

# Builder-only packages. Nothing installed here reaches the final image: only
# /opt/riscv and /opt/riscv-docs are copied out. device-tree-compiler serves
# Spike's `make check`; the final stage installs its own runtime copy.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl device-tree-compiler file git xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# RISC-V GNU toolchain (prebuilt, pinned) — the xPack Newlib bare-metal build.
# Chosen because it ships a *rich multilib set* — rv32i / rv32im / rv32imc
# (ilp32), the rv32e/f/d variants, and the rv64 ABIs — which the target cores
# require (ibex builds rv32imc/ilp32, picorv32 rv32i/im/imc). The riscv-collab
# nightly prebuilts are single-arch (rv64gc- or rv32gc-only) and cannot link
# rv32im/ilp32 firmware, so they are deliberately NOT used here. Prebuilt over a
# 30–60 min from-source build, mirroring how the base pins OpenROAD/sv2v.
# --strip-components=1 flattens the tarball's version-stamped top dir.
#
# The xPack driver is prefixed `riscv-none-elf-`, but ibex's common.mk and
# picorv32's makefiles invoke `riscv32-unknown-elf-` / `riscv64-unknown-elf-`.
# Alias BOTH triples to every helper executable: gcc derives its assembler/linker lookup from
# argv[0]'s prefix, so the whole binutils set is aliased, not just gcc. The
# actual ISA/ABI is selected by the projects' explicit -march/-mabi flags, which
# the multilib set resolves regardless of the driver's name.
# ---------------------------------------------------------------------------
ARG XPACK_GCC_VERSION=15.2.0-1
ARG XPACK_GCC_SHA256=aaaa8060c914851a3e5ee1ba82cc3d6f80972f90638a05c6e823a37557a33758
RUN echo ">>> Installing xPack RISC-V GNU toolchain ${XPACK_GCC_VERSION} (multilib newlib)..." \
    && mkdir -p /opt/riscv \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v${XPACK_GCC_VERSION}/xpack-riscv-none-elf-gcc-${XPACK_GCC_VERSION}-linux-x64.tar.gz" \
        -o /tmp/riscv-toolchain.tar.gz \
    && echo "${XPACK_GCC_SHA256}  /tmp/riscv-toolchain.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/riscv-toolchain.tar.gz -C /opt/riscv --strip-components=1 \
    && rm -f /tmp/riscv-toolchain.tar.gz \
    && set -- $(find /opt/riscv/riscv-none-elf/lib -type f -name libg.a) \
    && test "$#" -eq 32 \
    && for duplicate do \
           original="${duplicate%/libg.a}/libc.a"; \
           cmp -s "$original" "$duplicate"; \
           rm -f "$duplicate"; \
           ln "$original" "$duplicate"; \
       done \
    && for names in 'c++ g++' 'gcc gcc-15.2.0' 'ld ld.bfd'; do \
           set -- $names; \
           original="/opt/riscv/bin/riscv-none-elf-$1"; \
           duplicate="/opt/riscv/bin/riscv-none-elf-$2"; \
           cmp -s "$original" "$duplicate"; \
           rm -f "$duplicate"; \
           ln "$original" "$duplicate"; \
       done \
    && for helper in ar as ld ld.bfd nm objcopy objdump ranlib readelf strip; do \
           original="/opt/riscv/bin/riscv-none-elf-${helper}"; \
           duplicate="/opt/riscv/riscv-none-elf/bin/${helper}"; \
           cmp -s "$original" "$duplicate"; \
           rm -f "$duplicate"; \
           ln "$original" "$duplicate"; \
       done \
    && for f in /opt/riscv/bin/riscv-none-elf-*; do \
           helper_executable="$(basename "$f" | sed 's/^riscv-none-elf-//')"; \
           ln -sf "$f" "/opt/riscv/bin/riscv32-unknown-elf-${helper_executable}"; \
           ln -sf "$f" "/opt/riscv/bin/riscv64-unknown-elf-${helper_executable}"; \
       done \
    && /opt/riscv/bin/riscv-none-elf-gcc --version
ENV PATH="/opt/riscv/bin:${PATH}"

# ---------------------------------------------------------------------------
# Spike (riscv-isa-sim) — the canonical RISC-V reference ISS, used as the
# golden model for differential testing (e.g. picorv32 torture & csmith flows).
# Bundles libfesvr. Installed into /opt/riscv so it shares the toolchain's
# already-on-PATH bin dir. This is official upstream Spike; Ibex's UVM
# co-simulation needs lowRISC's ibex-cosim fork, which is not provided here.
#
# Spike has no maintained release series (v1.1.0, from 2021, no longer
# compiles with modern GCC), so this pins a tested snapshot of official
# upstream master by full SHA. ADR 0069 defines how the pin is selected,
# refreshed, and accepted. The explicit checks make a broken build fail the
# image loudly.
# ---------------------------------------------------------------------------
ARG SPIKE_REF=609dbe0b9994154833039209fa37151e7c05e9d4
RUN echo ">>> Building Spike (riscv-isa-sim) ${SPIKE_REF} from source..." \
    && git init /tmp/spike \
    && cd /tmp/spike \
    && git remote add origin https://github.com/riscv-software-src/riscv-isa-sim.git \
    && git fetch --depth 1 origin "${SPIKE_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${SPIKE_REF}" \
    && mkdir -p /tmp/spike/build && cd /tmp/spike/build \
    && ../configure --prefix=/opt/riscv \
        --without-boost --without-boost-asio --without-boost-regex \
    && make -j"$(nproc)" \
    && make check \
    && make install \
    && test -x /opt/riscv/bin/spike \
    && strip --strip-all \
        /opt/riscv/bin/spike \
        /opt/riscv/bin/spike-log-parser \
        /opt/riscv/bin/termios-xspike \
        /opt/riscv/bin/xspike \
        /opt/riscv/lib/libcustomext.so \
        /opt/riscv/lib/libriscv.so \
    && spike --help >/dev/null \
    && rm -rf /tmp/spike

# ---------------------------------------------------------------------------
# RISC-V International ratified specifications — baked in so the in-container
# agent (whose egress is locked to LLM endpoints) can read them offline. This
# is the authoritative core set from the github.com/riscv org, pinned to the
# ratified releases; it is NOT every document RVI has ever published (that set
# is unbounded and lives across dozens of extension repos), but it is the
# canonical reference for ISA/privileged/debug/ABI questions.
#   riscv-spec.{pdf,html}          — unprivileged + privileged ISA manual
#   riscv-debug-specification.pdf  — external debug support
#   riscv-abi.pdf                  — ELF psABI / calling convention
# ---------------------------------------------------------------------------
ARG ISA_MANUAL_RELEASE=riscv-isa-release-60d323c-2026-07-06
ARG DEBUG_SPEC_RELEASE=1.0
ARG PSABI_RELEASE=v1.0
ARG ISA_MANUAL_PDF_SHA256=5aae3568f952a4e2f10dab7a204ec7a43b13a1c068be2d9aa7995f418e941d03
ARG ISA_MANUAL_HTML_SHA256=41c79800bd7b97fcdeaf564d4a6f8689e895dcd932eecc4207dc582d3e1503ad
ARG DEBUG_SPEC_SHA256=ce2787b25233a6109c9bc767b2bc497798148b721390f72fb9b48ff0ed986fc8
ARG PSABI_SHA256=a8d06bdcaa82a6a4567a1904dc27ef1ca1043ebaa1f523558c927a9d72bc23d9
RUN echo ">>> Downloading ratified RISC-V International specifications..." \
    && mkdir -p /opt/riscv-docs \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/riscv/riscv-isa-manual/releases/download/${ISA_MANUAL_RELEASE}/riscv-spec.pdf" \
        -o /opt/riscv-docs/riscv-isa-manual.pdf \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/riscv/riscv-isa-manual/releases/download/${ISA_MANUAL_RELEASE}/riscv-spec.html" \
        -o /opt/riscv-docs/riscv-isa-manual.html \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/riscv/riscv-debug-spec/releases/download/${DEBUG_SPEC_RELEASE}/riscv-debug-specification.pdf" \
        -o /opt/riscv-docs/riscv-debug-specification.pdf \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/riscv-non-isa/riscv-elf-psabi-doc/releases/download/${PSABI_RELEASE}/riscv-abi.pdf" \
        -o /opt/riscv-docs/riscv-abi.pdf \
    && echo "${ISA_MANUAL_PDF_SHA256}  /opt/riscv-docs/riscv-isa-manual.pdf" | sha256sum -c - \
    && echo "${ISA_MANUAL_HTML_SHA256}  /opt/riscv-docs/riscv-isa-manual.html" | sha256sum -c - \
    && echo "${DEBUG_SPEC_SHA256}  /opt/riscv-docs/riscv-debug-specification.pdf" | sha256sum -c - \
    && echo "${PSABI_SHA256}  /opt/riscv-docs/riscv-abi.pdf" | sha256sum -c - \
    && printf '%s\n' \
        '# RISC-V International specifications (offline copy)' \
        '' \
        'Ratified reference set baked into the booley-sandbox-riscv image.' \
        '' \
        "- riscv-isa-manual.pdf / .html — unprivileged + privileged ISA manual (${ISA_MANUAL_RELEASE})" \
        "- riscv-debug-specification.pdf — external debug support (${DEBUG_SPEC_RELEASE})" \
        "- riscv-abi.pdf — ELF psABI / calling convention (${PSABI_RELEASE})" \
        '' \
        'Search HTML directly, or extract PDF text with: pdftotext <file.pdf> -' \
        '' \
        'Source: https://github.com/riscv  •  path exported as $BOOLEY_RISCV_DOCS' \
        > /opt/riscv-docs/INDEX.md

# ---------------------------------------------------------------------------
# Final stage: the exact standard substrate plus the RISC-V tooling payload.
# ---------------------------------------------------------------------------
FROM booley-standard-substrate

# Everything below installs system-wide; drop back to the agent user at the end
# to match the base image's runtime posture.
USER root

# ---------------------------------------------------------------------------
# RISC-V build/sim helper programs from apt:
#   srecord              — srec_cat; ibex hard-depends on it for .vmem memory
#                          image generation (examples/.../common.mk).
#   device-tree-compiler — dtc; Spike compiles its device tree at runtime, and
#                          many RISC-V SoC flows need it.
#   poppler-utils        — pdftotext; makes the baked reference PDFs searchable
#                          from an agent or shell without network access.
# ---------------------------------------------------------------------------
RUN echo ">>> Installing srecord + device-tree-compiler + poppler-utils..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        srecord device-tree-compiler poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# One COPY per tree keeps every xPack hard-link group inside a single exported
# layer, which the image contract's link audit requires.
COPY --from=riscv-tooling /opt/riscv /opt/riscv
COPY --from=riscv-tooling /opt/riscv-docs /opt/riscv-docs
ENV PATH="/opt/riscv/bin:${PATH}"
ENV BOOLEY_RISCV_DOCS=/opt/riscv-docs

# Post-PATH executable test on the composed image. The tooling stage's checks
# ran on the bare builder; this proves the copied drivers resolve the way every
# downstream Makefile will invoke them and that Spike's shared libraries load
# against this substrate. Both aliased triples are covered because gcc derives
# its binutils lookup from argv[0].
RUN riscv-none-elf-gcc --version >/dev/null \
    && riscv32-unknown-elf-gcc --version >/dev/null \
    && riscv64-unknown-elf-gcc --version >/dev/null \
    && spike --help >/dev/null \
    && echo ">>> RISC-V toolchain on PATH: $(riscv-none-elf-gcc -dumpversion)"

# Marks the image variant so utility scripts and Doctor can detect the RISC-V flavour.
ENV BOOLEY_SANDBOX_FLAVOR=riscv

# Restore the base image's runtime user/workdir.
USER agent
WORKDIR /work
