# Published Booley EDA/runtime base — invariant tools and Python dependencies.
# Candidate application code, B-Wave, and repository patches belong in Dockerfile.
#
# OpenROAD's public Debian channel ended after the 2024-12-14 release. Extract
# the exact 26Q4 binary and Corresponding Source from its official builder, but
# run from the exact dependency image used by upstream's final stage. The
# builder is intentionally throwaway: its object files and regression fixtures
# account for most of the old Sandbox Image.
# Global default; each stage that uses the revision redeclares it bare.
ARG OPENROAD_SOURCE_REF=c4d317e4fa2398b9880920a1411c20258a2175a9
FROM docker.io/openroad/ubuntu26.04@sha256:c3185708e2f1cdb4fed9fb4d84d2882d36a1f1f6af90959ceb07dcb7416fe49d AS openroad-artifacts

USER root
ARG OPENROAD_SOURCE_REF
# Corresponding Source excludes build outputs. Since 26Q4 the builder also
# leaves an install prefix whose ./install/bin/openroad duplicates the shipped
# executable (~58 MB compressed), so both trees stay out and the archive
# listing must prove it before the archive leaves this stage.
RUN archive="/tmp/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" \
    && tar --sort=name --mtime='UTC 2026-10-01' --owner=0 --group=0 --numeric-owner \
        --exclude='./build' --exclude='./install' -C /OpenROAD -czf "$archive" . \
    && tar -tzf "$archive" > /tmp/openroad-source-listing.txt \
    && grep -Fx './src/rsz/src/Resizer.tcl' /tmp/openroad-source-listing.txt >/dev/null \
    && ! grep -Eq '^\./(build|install)(/|$)' /tmp/openroad-source-listing.txt \
    && rm /tmp/openroad-source-listing.txt

FROM docker.io/openroad/ubuntu26.04-dev@sha256:a971c4db78c9a4a8db18a9fe136c9731c613e4582a5093180bc7c07e24351e09 AS eda-artifacts

# Heavy compilers and development packages stay in this throwaway stage. The
# runtime below receives only the installed EDA artifacts.
USER root
WORKDIR /

# Retry transient apt and git failures (#4420); the helper lives in this throwaway stage.
RUN printf 'Acquire::Retries "8";\n' > /etc/apt/apt.conf.d/99-network-retries \
    && printf '%s\n' '#!/bin/sh' \
        '# Run "$@"; retry a failure up to 8 times, 30 s apart.' \
        'attempt=1' \
        'until "$@"; do' \
        '    test "$attempt" -le 8 || exit 1' \
        '    echo "booley-retry: $1 failed (attempt $attempt); retrying in 30 s" >&2' \
        '    attempt=$((attempt + 1))' \
        '    sleep 30' \
        'done' > /usr/local/bin/booley-retry \
    && chmod 0755 /usr/local/bin/booley-retry

# Yosys + ABC + native slang frontend, built from source.
#
# Yosys 0.67 replaced the old `make config-gcc` Makefile flow with CMake
# (>=3.28; the Ubuntu 26.04 builder ships 4.2.3). The SystemVerilog `read_slang` frontend
# (povik/sv-elab on top of MikePopoloski/slang) is a git submodule and is
# ENABLED BY DEFAULT — there is no enable flag; slang is built unless
# -DYOSYS_WITHOUT_SLANG=ON is passed. Its C++ deps (fmt/cxxopts/boost_regex)
# are vendored as Yosys submodules, so no extra apt packages beyond the base
# image's flex/bison/libfl-dev (line ~23) plus cmake/gawk here. Submodules are
# fetched full (NOT --shallow-submodules): sv-elab/slang pin non-tip commits a
# shallow submodule fetch can miss.
# renovate: datasource=github-tags depName=YosysHQ/yosys
ARG YOSYS_VERSION=v0.70
# pin-companion: YOSYS_VERSION
ARG YOSYS_REF=28ba3cb926fe376fa05ebfc1b921747d011d4557
RUN echo ">>> Building Yosys ${YOSYS_VERSION} (${YOSYS_REF}) + slang from source (this takes a while)..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        cmake gawk pkg-config tcl-dev libreadline-dev libffi-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/yosys \
    && cd /tmp/yosys \
    && git remote add origin https://github.com/YosysHQ/yosys.git \
    && booley-retry git -c protocol.version=0 fetch --depth 1 origin "${YOSYS_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${YOSYS_REF}" \
    && booley-retry git -c protocol.version=0 submodule update --init --recursive \
    && cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_CXX_COMPILER=g++ \
    && cmake --build build --parallel "$(nproc)" \
    && cmake --install build --strip \
    && yosys-abc -c "quit" \
    && yosys -p 'help read_slang' >/dev/null \
    && rm -rf /tmp/yosys

# Icarus Verilog is built from source because Ubuntu packages lag releases.
# renovate: datasource=github-tags depName=steveicarus/iverilog versioning=regex:^v(?<major>\d+)_(?<minor>\d+)$
ARG ICARUS_VERSION=v13_0
# pin-companion: ICARUS_VERSION
ARG ICARUS_REF=dfeee909ed9f20b4870dd93423156c0170c0e1ff
RUN echo ">>> Building Icarus Verilog ${ICARUS_VERSION} (${ICARUS_REF}) from source..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        file gperf libreadline-dev zlib1g-dev libbz2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/iverilog \
    && cd /tmp/iverilog \
    && git remote add origin https://github.com/steveicarus/iverilog.git \
    && booley-retry git -c protocol.version=0 fetch --depth 1 origin "${ICARUS_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${ICARUS_REF}" \
    && sh autoconf.sh \
    && ./configure --prefix=/usr/local \
    && make -j$(nproc) \
    && make install \
    && find /usr/local/bin/iverilog /usr/local/bin/vvp /usr/local/lib/ivl \
        -type f -exec sh -c 'for artifact do case "$(file -b "$artifact")" in ELF*) strip --strip-unneeded "$artifact";; esac; done' sh {} + \
    && iverilog -V >/dev/null 2>&1 \
    && rm -rf /tmp/iverilog

# Verilator is built from source so host installations do not affect results.
# v5.052 is the first stable release after the v5.050 nested-shift miscompile
# fix (a6f4dd031f50387ae0169490c6d8843b91dd1c07). Keep the full immutable
# release commit beside the human-readable tag.
# renovate: datasource=github-tags depName=verilator/verilator
ARG VERILATOR_VERSION=v5.054
# pin-companion: VERILATOR_VERSION
ARG VERILATOR_REF=bbb60a403932a9f695cb6ff001ceb73de6ad9234
RUN echo ">>> Building Verilator ${VERILATOR_VERSION} (${VERILATOR_REF}) from source (this takes a while)..." \
    && apt-get update && apt-get install -y --no-install-recommends help2man liblz4-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/verilator \
    && cd /tmp/verilator \
    && git remote add origin https://github.com/verilator/verilator.git \
    && booley-retry git -c protocol.version=0 fetch --depth 1 origin "${VERILATOR_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${VERILATOR_REF}" \
    && autoconf && ./configure --prefix=/usr/local \
    && make -j4 && make install \
    && find /usr/local/bin -maxdepth 1 -type f -name 'verilator*_bin*' \
        -exec strip --strip-unneeded {} + \
    && verilator --version | grep -F "Verilator ${VERILATOR_VERSION#v}" \
    && printf '%s\n' \
        "Verilator release: ${VERILATOR_VERSION}" \
        "Verilator source revision: ${VERILATOR_REF}" \
        > /usr/local/share/verilator/BOOLEY-SOURCE.txt \
    && rm -rf /tmp/verilator

# Minimal Sandbox. The immutable upstream development image remains the
# EDA builder, but none of its compilers, Docker tooling, Pandoc, LLVM, CMake,
# headers, or build caches become runtime layers.
FROM docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/Los_Angeles \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

USER root
WORKDIR /

# Tolerate host clock skew during image build (win_test): on Windows hosts the
# Docker Desktop/WSL2 VM inherits the host clock; a skewed host (common on
# dual-boot RTC-vs-UTC setups) makes apt reject freshly-published Release
# files as "not valid yet". Package integrity remains GPG-verified.
RUN printf 'Acquire::Check-Date "false";\n' > /etc/apt/apt.conf.d/99-tolerate-clock-skew \
    && printf 'Acquire::Retries "8";\n' > /etc/apt/apt.conf.d/99-network-retries

# Development support intentionally stops at the native C/C++ toolchain and
# headers needed by project and Verilator builds. The remaining packages are
# the audited runtime closure for OpenROAD, Yosys, Icarus, Python, and Booley.
RUN echo ">>> Installing minimal runtime dependencies and Python 3.14..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates ccache curl file g++ gcc git gnu-coreutils jq locales make \
        ripgrep time unzip xz-utils zlib1g-dev \
        libbz2-1.0 libffi8 libgomp1 liblz4-dev libpixman-1-0 libpython3.14 \
        libreadline8t64 libtcl8.6 libudev1 libyaml-cpp0.8 tcl tcllib zlib1g \
        libgl1 libopengl0 libqt5charts5 libqt5core5t64 libqt5gui5t64 \
        libqt5widgets5t64 libxcb-cursor0 qt5-image-formats-plugins \
        python3.14 python3.14-dev python3.14-venv python3-pip \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.14 /usr/bin/python3 \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Ubuntu's build-essential requires coreutils-from-uutils. Keep that selector
# installed, but expose every packaged GNU command through the standard
# /usr/local/bin precedence used by login shells and direct subprocesses.
# Package updates replace the GNU payloads without invalidating these links.
RUN dpkg-query -L gnu-coreutils | while IFS= read -r executable; do \
        case "$executable" in \
            /usr/bin/gnu*) ln -s "$executable" "/usr/local/bin/${executable#/usr/bin/gnu}" ;; \
        esac; \
    done

# Copy only installed EDA payloads out of the throwaway dependency/build stage.
COPY --from=eda-artifacts /usr/local/bin/yosys* /usr/local/bin/
COPY --from=eda-artifacts /usr/local/share/yosys/ /usr/local/share/yosys/
COPY --from=eda-artifacts /usr/local/bin/iverilog* /usr/local/bin/vvp /usr/local/bin/
COPY --from=eda-artifacts /usr/local/lib/ivl/ /usr/local/lib/ivl/
COPY --from=eda-artifacts /usr/local/include/iverilog/ /usr/local/include/iverilog/
COPY --from=eda-artifacts /usr/local/bin/verilator* /usr/local/bin/
COPY --from=eda-artifacts /usr/local/share/verilator/ /usr/local/share/verilator/
COPY --from=eda-artifacts /usr/local/share/pkgconfig/verilator.pc /usr/local/share/pkgconfig/verilator.pc
COPY --from=eda-artifacts /usr/local/share/man/man1/iverilog* /usr/local/share/man/man1/vvp.1 /usr/local/share/man/man1/
COPY --from=eda-artifacts /usr/local/share/man/man1/verilator* /usr/local/share/man/man1/

# OpenROAD — physical synthesis: placement, buffering/sizing, and estimated
# wire RC. The binary remains byte-identical to the digest-pinned builder. Its
# runtime receives only the OR-Tools library closure, not its 177 MB development
# headers, examples, executables, or CMake metadata.
ARG OPENROAD_VERSION=26Q4
ARG OPENROAD_SOURCE_REF
ARG OPENROAD_BINARY_VERSION=26Q3-2927-gc4d317e4fa
ARG OPENROAD_SOURCE_SENTINEL_SHA256=8f72ff3a40bf361df9eee1d4a6ecf163285ebabca3d49c0f8eb958810f65a590
COPY --from=openroad-artifacts /OpenROAD/build/bin/openroad /usr/bin/openroad
COPY --from=openroad-artifacts /opt/or-tools/lib/ /opt/or-tools/lib/
COPY --from=openroad-artifacts /OpenROAD/LICENSE /usr/local/share/doc/openroad/LICENSE
COPY --from=openroad-artifacts /OpenROAD/src/sta/LICENSE /usr/local/share/doc/openroad/OpenSTA-LICENSE
COPY --from=openroad-artifacts /tmp/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz /usr/local/share/doc/openroad/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz
COPY src/booley/data/docker/openroad-source-manifest.json /usr/local/share/doc/openroad/source-manifest.json
RUN echo ">>> Verifying OpenROAD ${OPENROAD_VERSION} (${OPENROAD_SOURCE_REF})..." \
    && test "$(/usr/bin/openroad -version | xargs)" = "${OPENROAD_BINARY_VERSION}" \
    && test "$(tar -xOf "/usr/local/share/doc/openroad/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" \
        ./src/rsz/src/Resizer.tcl | sha256sum | awk '{print $1}')" = \
        "${OPENROAD_SOURCE_SENTINEL_SHA256}" \
    && python3 -c 'import json; manifest=json.load(open("/usr/local/share/doc/openroad/source-manifest.json")); import sys; assert manifest["revision"] == sys.argv[1]; assert len(manifest["submodules"]) == 5' "${OPENROAD_SOURCE_REF}" \
    && test -f /usr/local/share/doc/openroad/LICENSE \
    && test -f /usr/local/share/doc/openroad/OpenSTA-LICENSE \
    && ln -s /usr/bin/openroad /usr/local/bin/openroad \
    && printf '%s\n' \
        "OpenROAD source revision: ${OPENROAD_SOURCE_REF}" \
        "Corresponding Source: /usr/local/share/doc/openroad/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" \
        'Recursive source manifest: /usr/local/share/doc/openroad/source-manifest.json' \
        'OpenROAD license: /usr/local/share/doc/openroad/LICENSE' \
        'OpenSTA license: /usr/local/share/doc/openroad/OpenSTA-LICENSE' \
        > /usr/local/share/doc/openroad/BOOLEY-SOURCE.txt \
    && openroad -version \
    && yosys -p 'help read_slang' >/dev/null \
    && iverilog -V >/dev/null 2>&1 \
    && verilator --version >/dev/null

# Worktrees are bind-mounted from the host with different ownership. Identity
# defaults remain neutral; projects override these per worktree.
RUN git config --system --add safe.directory '*' \
    && git config --system user.name "Dev" \
    && git config --system user.email "dev@localhost"

# sv2v (pinned release binary)
# renovate: datasource=github-releases depName=zachjs/sv2v
ARG SV2V_VERSION=v0.0.13
# pin-companion: SV2V_VERSION
ARG SV2V_SHA256=552799a1d76cd177b9b4cc63a3e77823a3d2a6eb4ec006569288abeff28e1ff8
RUN echo ">>> Installing sv2v ${SV2V_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors "https://github.com/zachjs/sv2v/releases/download/${SV2V_VERSION}/sv2v-Linux.zip" \
    -o /tmp/sv2v.zip \
    && echo "${SV2V_SHA256}  /tmp/sv2v.zip" | sha256sum -c - \
    && unzip -o /tmp/sv2v.zip -d /tmp/sv2v \
    && cp /tmp/sv2v/sv2v-Linux/sv2v /usr/local/bin/sv2v \
    && chmod +x /usr/local/bin/sv2v && rm -rf /tmp/sv2v.zip /tmp/sv2v

# Verible (pinned prebuilt static binary — the sv2v pattern). Bundled
# lint EDA tool for .core lint Targets with flow_options.tool: verible (ADR 0033).
# renovate: datasource=github-releases depName=chipsalliance/verible versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)-(?<patch>\d+)-g[0-9a-f]+$
ARG VERIBLE_VERSION=v0.0-4298-g085eef05
# pin-companion: VERIBLE_VERSION
ARG VERIBLE_SHA256=ca83778c7c2b73272277bd670d1851c8caf973fd3283688aeb0d36d4b3598a90
RUN echo ">>> Installing Verible ${VERIBLE_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors "https://github.com/chipsalliance/verible/releases/download/${VERIBLE_VERSION}/verible-${VERIBLE_VERSION}-linux-static-x86_64.tar.gz" \
    -o /tmp/verible.tar.gz \
    && echo "${VERIBLE_SHA256}  /tmp/verible.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/verible.tar.gz -C /tmp \
    && cp /tmp/verible-${VERIBLE_VERSION}/bin/* /usr/local/bin/ \
    && strip --strip-unneeded /usr/local/bin/verible-* \
    && rm -rf /tmp/verible.tar.gz /tmp/verible-${VERIBLE_VERSION} \
    && verible-verilog-lint --version

# Verilog-HDL and Live Preview (pinned MIT VSIXs). They install by file path
# from the generated devcontainer spec, so an egress-locked local Sandbox needs
# no extension gallery and VS Code pins the install. Each
# VERILOGHDL_VERSION / LIVE_PREVIEW_VERSION must equal the version in the
# matching booley.runtime.devcontainer VSIX path (tests enforce the lockstep).
# Both are MIT: the build fails unless the shipped LICENSE.txt says so, and the
# license, third-party notices and a source pointer ship beside the image.
# renovate: datasource=custom.openvsx depName=mshr-h/veriloghdl
ARG VERILOGHDL_VERSION=1.29.1
# pin-companion: VERILOGHDL_VERSION
ARG VERILOGHDL_SHA256=eb7f4a046cd579e92247bc05b6e2fcff14fd6b7f8703a748a3e22a1d44b86a32
# pin-companion: VERILOGHDL_VERSION
ARG VERILOGHDL_SOURCE_TAG=v1.29.1
# pin-companion: VERILOGHDL_VERSION
ARG VERILOGHDL_SOURCE_COMMIT=44a5534c66e78bd8472eb6803b0a122ebeee8aba
RUN echo ">>> Bundling Verilog-HDL ${VERILOGHDL_VERSION} VSIX..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors "https://open-vsx.org/api/mshr-h/veriloghdl/${VERILOGHDL_VERSION}/file/mshr-h.veriloghdl-${VERILOGHDL_VERSION}.vsix" \
    -o /tmp/veriloghdl.vsix \
    && echo "${VERILOGHDL_SHA256}  /tmp/veriloghdl.vsix" | sha256sum -c - \
    && install -d -m 0755 /usr/local/libexec/booley /usr/local/share/booley/licenses/veriloghdl \
    && unzip -p /tmp/veriloghdl.vsix extension/LICENSE.txt \
        > /usr/local/share/booley/licenses/veriloghdl/LICENSE.txt \
    && unzip -p /tmp/veriloghdl.vsix extension/THIRD_PARTY_NOTICES.md \
        > /usr/local/share/booley/licenses/veriloghdl/THIRD_PARTY_NOTICES.md \
    && grep -q "MIT License" /usr/local/share/booley/licenses/veriloghdl/LICENSE.txt \
    && grep -q "Permission is hereby granted, free of charge" /usr/local/share/booley/licenses/veriloghdl/LICENSE.txt \
    && install -m 0644 /tmp/veriloghdl.vsix "/usr/local/libexec/booley/veriloghdl-${VERILOGHDL_VERSION}.vsix" \
    && printf '%s\n' \
        "Verilog-HDL ${VERILOGHDL_VERSION} (mshr-h.veriloghdl), MIT, see LICENSE.txt and THIRD_PARTY_NOTICES.md." \
        "Redistributed unmodified as /usr/local/libexec/booley/veriloghdl-${VERILOGHDL_VERSION}.vsix" \
        "(Open VSX build, sha256 ${VERILOGHDL_SHA256})." \
        "Source: https://github.com/mshr-h/vscode-verilog-hdl-support" \
        "  tag ${VERILOGHDL_SOURCE_TAG}, commit ${VERILOGHDL_SOURCE_COMMIT}" \
        > /usr/local/share/booley/licenses/veriloghdl/SOURCE.txt \
    && chmod 0644 /usr/local/share/booley/licenses/veriloghdl/LICENSE.txt \
        /usr/local/share/booley/licenses/veriloghdl/THIRD_PARTY_NOTICES.md \
        /usr/local/share/booley/licenses/veriloghdl/SOURCE.txt \
    && rm -f /tmp/veriloghdl.vsix

# renovate: datasource=custom.openvsx depName=ms-vscode/live-server
ARG LIVE_PREVIEW_VERSION=0.4.20
# pin-companion: LIVE_PREVIEW_VERSION
ARG LIVE_PREVIEW_SHA256=672ff5bbed08a3d2387a63837c0087ba95108db1ca3f4656837cace48884a133
# pin-companion: LIVE_PREVIEW_VERSION
ARG LIVE_PREVIEW_SOURCE_TAG=v0.4.20
# pin-companion: LIVE_PREVIEW_VERSION
ARG LIVE_PREVIEW_SOURCE_COMMIT=5b3ce20cdd17ca462825606863a1b95f368695fc
RUN echo ">>> Bundling Live Preview ${LIVE_PREVIEW_VERSION} VSIX..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors "https://open-vsx.org/api/ms-vscode/live-server/${LIVE_PREVIEW_VERSION}/file/ms-vscode.live-server-${LIVE_PREVIEW_VERSION}.vsix" \
    -o /tmp/live-server.vsix \
    && echo "${LIVE_PREVIEW_SHA256}  /tmp/live-server.vsix" | sha256sum -c - \
    && install -d -m 0755 /usr/local/libexec/booley /usr/local/share/booley/licenses/live-server \
    && unzip -p /tmp/live-server.vsix extension/LICENSE.txt \
        > /usr/local/share/booley/licenses/live-server/LICENSE.txt \
    && unzip -p /tmp/live-server.vsix extension/out/extension.js.LICENSE.txt \
        > /usr/local/share/booley/licenses/live-server/extension.js.LICENSE.txt \
    && grep -q "MIT License" /usr/local/share/booley/licenses/live-server/LICENSE.txt \
    && grep -q "Permission is hereby granted, free of charge" /usr/local/share/booley/licenses/live-server/LICENSE.txt \
    && install -m 0644 /tmp/live-server.vsix "/usr/local/libexec/booley/live-server-${LIVE_PREVIEW_VERSION}.vsix" \
    && printf '%s\n' \
        "Live Preview ${LIVE_PREVIEW_VERSION} (ms-vscode.live-server), MIT, see LICENSE.txt and extension.js.LICENSE.txt." \
        "Redistributed unmodified as /usr/local/libexec/booley/live-server-${LIVE_PREVIEW_VERSION}.vsix" \
        "(Open VSX build, sha256 ${LIVE_PREVIEW_SHA256})." \
        "Source: https://github.com/microsoft/vscode-livepreview" \
        "  tag ${LIVE_PREVIEW_SOURCE_TAG}, commit ${LIVE_PREVIEW_SOURCE_COMMIT}" \
        > /usr/local/share/booley/licenses/live-server/SOURCE.txt \
    && chmod 0644 /usr/local/share/booley/licenses/live-server/LICENSE.txt \
        /usr/local/share/booley/licenses/live-server/extension.js.LICENSE.txt \
        /usr/local/share/booley/licenses/live-server/SOURCE.txt \
    && rm -f /tmp/live-server.vsix

# Headless Chrome for T3 Code's preview panel: every Sandbox
# Image carries it. Chrome for Testing's headless shell at the version T3
# Code pins (apps/server/src/preview/PreviewBrowser.ts). Sandbox start links
# it into T3 Code's tools directory when the VERSION record written here
# matches T3 Code's, so T3 Code attempts no download, which the egress rules
# block (#5906). --version loads every shared library, so a missing one fails
# the build.
# The T3 Code release in agent-clis-package.json pins this version; hold
# 157.0.8103.78 and move the hold in .github/renovate.json with each bump.
# renovate: datasource=custom.chrome-for-testing depName=chrome-headless-shell versioning=regex:^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
ARG CHROME_HEADLESS_SHELL_VERSION=157.0.8103.78
# pin-companion: CHROME_HEADLESS_SHELL_VERSION
ARG CHROME_HEADLESS_SHELL_SHA256=f90329720fb61e5a76da9b6b509b6ad12a484c9c5df0359403e935177c6d153a
RUN apt-get update && apt-get install -y --no-install-recommends \
        libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
        libnspr4 libnss3 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*
RUN echo ">>> Installing chrome-headless-shell ${CHROME_HEADLESS_SHELL_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_HEADLESS_SHELL_VERSION}/linux64/chrome-headless-shell-linux64.zip" \
    -o /tmp/chrome-headless-shell.zip \
    && echo "${CHROME_HEADLESS_SHELL_SHA256}  /tmp/chrome-headless-shell.zip" | sha256sum -c - \
    && unzip -q /tmp/chrome-headless-shell.zip -d /tmp/chrome-headless-shell \
    && mv /tmp/chrome-headless-shell/chrome-headless-shell-linux64 /opt/chrome-headless-shell \
    && ln -s /opt/chrome-headless-shell/chrome-headless-shell /usr/local/bin/chrome-headless-shell \
    && rm -rf /tmp/chrome-headless-shell.zip /tmp/chrome-headless-shell \
    && test "$(chrome-headless-shell --version)" = "Google Chrome for Testing ${CHROME_HEADLESS_SHELL_VERSION}" \
    && printf '%s\n' "${CHROME_HEADLESS_SHELL_VERSION}" > /opt/chrome-headless-shell/VERSION

# Node.js 24 LTS + agent CLIs. Download exact publisher artifacts and verify
# them before execution; neither a mutable setup script nor semver ranges are
# allowed in the release image.
# renovate: datasource=node-version depName=node
ARG NODE_VERSION=24.22.3
# pin-companion: NODE_VERSION
ARG NPM_VERSION=11.19.1
# pin-companion: NODE_VERSION
ARG NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
COPY src/booley/data/docker/agent-clis-package.json /opt/agent-clis/package.json
COPY src/booley/data/docker/agent-clis-package-lock.json /opt/agent-clis/package-lock.json
RUN echo ">>> Installing Node.js ${NODE_VERSION} and exact agent CLIs..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        -o /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && rm -f /tmp/node.tar.xz \
    && test "$(npm --version)" = "${NPM_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap \
    && npm ci --prefix /opt/agent-clis --omit=dev --no-audit --no-fund --fetch-retries 5 \
    && CLAUDE_GLIBC=/opt/agent-clis/node_modules/@anthropic-ai/claude-code-linux-x64/claude \
    && CLAUDE_ACTIVE=/opt/agent-clis/node_modules/@anthropic-ai/claude-code/bin/claude.exe \
    && CLAUDE_MUSL=/opt/agent-clis/node_modules/@anthropic-ai/claude-code-linux-x64-musl \
    && test "$CLAUDE_GLIBC" -ef "$CLAUDE_ACTIVE" \
    && rm -rf "$CLAUDE_MUSL" \
    && test ! -e "$CLAUDE_MUSL" \
    && ln -s /opt/agent-clis/node_modules/.bin/claude /usr/local/bin/claude \
    && ln -s /opt/agent-clis/node_modules/.bin/codex /usr/local/bin/codex \
    && command -v bwrap \
    && rm -rf /var/lib/apt/lists/*

# The manifest (and its lock) is the only source of the agent CLI versions: the
# installed CLIs must report exactly the versions it pins.
RUN agent_cli_pin() { python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["dependencies"][sys.argv[2]])' /opt/agent-clis/package.json "$1"; } \
    && test "$(claude --version | awk '{print $1}')" = "$(agent_cli_pin @anthropic-ai/claude-code)" \
    && test "$(codex --version | awk '{print $2}')" = "$(agent_cli_pin @openai/codex)"

# T3 Code ships as a release tarball: its npm package downloads the real binary
# on first run, which the Sandbox egress rules block. The manifest holds the
# version and sha256. The launcher gives every way of starting T3 Code, and so
# its child processes, NODE_USE_ENV_PROXY=1 (Node's fetch ignores HTTPS_PROXY
# without it); an image-level ENV would reach every other Node program too.
# T3 Code names no preview browser version in its CLI, so the build reads it
# from the executable; a release that holds none or several fails here.
RUN t3code_pin() { python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["t3code"][sys.argv[2]])' /opt/agent-clis/package.json "$1"; } \
    && T3CODE_VERSION="$(t3code_pin version)" \
    && T3CODE_SHA256="$(t3code_pin sha256)" \
    && echo ">>> Installing T3 Code ${T3CODE_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL --retry 8 --retry-delay 30 --retry-all-errors \
        "https://github.com/pingdotgg/t3code/releases/download/v${T3CODE_VERSION}/t3-${T3CODE_VERSION}-linux-x64.tar.gz" \
        -o /tmp/t3code.tar.gz \
    && echo "${T3CODE_SHA256}  /tmp/t3code.tar.gz" | sha256sum -c - \
    && install -d -m 0755 /opt/t3code \
    && tar -xzf /tmp/t3code.tar.gz -C /opt/t3code --strip-components=1 --no-same-owner \
    && rm -f /tmp/t3code.tar.gz \
    && printf '%s\n' '#!/bin/sh' 'export NODE_USE_ENV_PROXY=1' 'exec /opt/t3code/t3 "$@"' \
        > /usr/local/bin/t3 \
    && chmod 0755 /usr/local/bin/t3 \
    && test "$(t3 --version)" = "t3 v${T3CODE_VERSION}" \
    && LC_ALL=C grep -aoE 'VERSION = "[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+"' /opt/t3code/t3 \
        | cut -d'"' -f2 | sort -u > /opt/t3code/preview-browser-version \
    && test "$(wc -l < /opt/t3code/preview-browser-version)" -eq 1

# The container's network namespace is not the whole agent boundary: both
# clients can expose provider-hosted web MCP tools whose requests never originate
# in Docker. Enforce the offline contract in each client's system policy so
# user/project config and full-access modes cannot turn those MCP tools back on.
COPY src/booley/data/docker/codex-requirements.toml /etc/codex/requirements.toml
COPY src/booley/data/docker/claude-managed-settings.json /etc/claude-code/managed-settings.json
COPY src/booley/data/docker/t3code-policy.json /etc/t3code/policy.json
# T3 Code refuses to start (exit 77) on a policy it cannot use: fail the build instead.
RUN chmod 0755 /etc/t3code \
    && chmod 0644 /etc/t3code/policy.json \
    && t3 policy check /etc/t3code/policy.json
# Codex's requirements run this hook to block the T3 Code tools the list names.
COPY src/booley/data/docker/t3code_tool_deny_hook.py /usr/local/libexec/booley/t3code_tool_deny_hook.py
COPY src/booley/data/docker/t3code-denied-tools.txt /usr/local/libexec/booley/t3code-denied-tools.txt

# Non-root user for agent execution.
# Pin agent to uid/gid 1000 so it matches the typical first host user on native
# Linux; the base ubuntu:26.04 image already occupies 1000 with its default
# "ubuntu" user, so remove that first. Without this, bind-mounted project files
# (owned by host uid 1000) are unwritable by the container and the MCP server
# fails to create its job_logs dir.
RUN userdel -r ubuntu 2>/dev/null || true \
    && groupadd -g 1000 agent \
    && useradd -m -s /bin/bash -u 1000 -g 1000 agent

# Install the candidate's declared dependencies behind a cache boundary that
# changes only when pyproject.toml changes. The exporter preserves every PEP
# 508 string verbatim, including environment markers, and pip remains the one
# resolver for both this stable layer and ordinary wheel installation.
# Dependencies go system-wide so the booley-pip-local named volume cannot mask
# them at runtime.
#
# claude-agent-sdk ships a private, full-size Claude CLI even though this
# image already installs the normal npm CLI above. The SDK owns executable
# discovery; removing its duplicate makes it fall back to that system CLI.
# This build-time size optimization knowingly depends on the SDK's private
# bundle layout, but production runtime code does not. Remove it in the SAME
# layer that pip creates it; a later-layer deletion would hide the file from
# the merged filesystem without reclaiming any image storage.
# Only the dependencies exported from this copy are part of the base contract,
# so no later step may read anything else from it: two images with one contract
# could otherwise carry different copies.
COPY pyproject.toml /tmp/booley-build/pyproject.toml
COPY src/booley/data/docker/export_project_dependencies.py /tmp/booley-build/export_project_dependencies.py
# Ubuntu 26.04's system Python refuses ensurepip outside a venv; its supported
# pip is the distro python3-pip installed with the runtime closure above.
RUN python /tmp/booley-build/export_project_dependencies.py \
        /tmp/booley-build/pyproject.toml \
        /tmp/booley-build/project-dependencies.txt \
    && python -m pip install --break-system-packages --no-cache-dir --ignore-installed \
        --timeout 120 --retries 10 \
        --requirement /tmp/booley-build/project-dependencies.txt \
    && rm -f /tmp/booley-build/project-dependencies.txt \
    && python -m pip check \
    && CLAUDE_SDK_BUNDLED_CLI="$(python -c 'from pathlib import Path; import claude_agent_sdk; print(Path(claude_agent_sdk.__file__).parent / "_bundled" / "claude")')" \
    && test -x "$(command -v claude)" \
    && test -x "$CLAUDE_SDK_BUNDLED_CLI" \
    && rm -f "$CLAUDE_SDK_BUNDLED_CLI" \
    && test ! -e "$CLAUDE_SDK_BUNDLED_CLI"

# Publisher transfers for numerical and other large wheels can pause long
# enough to exceed pip's 15-second default even while the connection is sound.
# The large invariant SDK install above carries the same explicit policy; this
# inherited setting protects every later base- and candidate-image install.
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

# EDA invocation/registry layer (ADR 0019 + 0022) — pinned EXACTLY to the
# flow-API-stable pair. These also arrive transitively via the wheel's
# dependencies; pinning them explicitly here makes the contract visible in
# the image and guards against a future loosening of the wheel constraint.
# Edalize only *invokes* the EDA tools built above; it does not manage their
# versions (ADR 0019 decision). The exact pins live in
# base-python-requirements.txt, applied here as a pip constraints file so the
# two install layers keep their own --ignore-installed policy; a test holds the
# edalize/fusesoc copy equal to pyproject.toml.
COPY src/booley/data/docker/base-python-requirements.txt /tmp/booley-build/base-python-requirements.txt

RUN python -m pip install --break-system-packages --no-cache-dir \
    --constraint /tmp/booley-build/base-python-requirements.txt \
    edalize fusesoc

# Cocotb verification layer (ADR 0034 decision 10) — cocotb 2.x plus the
# small curated, pinned Python set a testbench may import (Booley Flows have no
# network, so anything beyond this set is vendored in the project tree).
# cocotbext-spi is ABSENT deliberately: no release imports against cocotb 2.x
# (0.5.0 still uses the removed cocotb.clock.BaseClock). Pins: see
# base-python-requirements.txt.
RUN python -m pip install --break-system-packages --no-cache-dir --ignore-installed \
    --constraint /tmp/booley-build/base-python-requirements.txt \
    cocotb numpy cocotbext-axi cocotbext-uart

# Build-time sanity (D2): the image fails to build rather than failing at
# first sim — cocotb-config resolves, the curated set imports, and the
# Icarus VPI library the run-half loads by absolute path exists. Cocotb 2.1
# returns the complete platform-suffixed path (`.so` on this Linux image).
RUN test "$(cocotb-config --version)" = "$(sed -n 's/^cocotb==//p' /tmp/booley-build/base-python-requirements.txt)" \
    && python3 -c "import cocotb, cocotbext.axi, cocotbext.uart, numpy" \
    && test -e "$(cocotb-config --lib-name-path vpi icarus)"

# Mutant generator parser (ADR 0088): the Mutation Flow parses Verilog and
# SystemVerilog with pyslang inside the Sandbox. The import fails the build if
# the wheel or its nanobind backend is missing.
RUN python -m pip install --break-system-packages --no-cache-dir --ignore-installed \
    --constraint /tmp/booley-build/base-python-requirements.txt \
    pyslang
RUN python3 -c "import pyslang"

USER agent

# Pre-create pip user-install dirs so named volumes inherit agent ownership
RUN mkdir -p /home/agent/.local/lib/python3.14/site-packages /home/agent/.local/bin
ENV PATH="/home/agent/.local/bin:${PATH}"
ENV PYTHONUSERBASE="/home/agent/.local"

# Sandbox detection (ADR 0028): marks every process in this image — including
# bare `docker exec` sessions, which devcontainer remoteEnv cannot reach —
# as running inside the Booley Sandbox. /.dockerenv is the fallback
# for containers from images built before this was added.
ENV BOOLEY_CONTAINER=1

# Chrome's own sandbox needs user namespaces, which the Sandbox's
# hardened flags (--cap-drop ALL, no-new-privileges, Docker's seccomp
# profile) do not allow: it exits with "No usable sandbox!". T3 Code reads
# this and runs its headless browser with --no-sandbox; the Sandbox
# itself is the boundary.
ENV T3CODE_SERVER_BROWSER_SANDBOX=0

# Claude Code kills an MCP tool call at 60s by default (measured on 2.1.205;
# ADR 0027 amendment 2026-07-09). 2h matches the Codex tool_timeout_sec the
# registrar writes. NOTE: the effective ceiling is still ~300s — the client's
# HTTP layer drops a response whose headers haven't arrived by then, and the
# booley server (json_response=True) sends headers only on completion — so
# server-side waits are capped at 270s; this ENV removes the 60s MCP-level
# kill underneath that. Image-level ENV so it reaches every entry path —
# tabs, docker exec — even when a stale devcontainer
# spec predates it.
ENV MCP_TOOL_TIMEOUT=7200000

# Separately, interactive Claude Code moves any MCP call still running after
# 120s into a background task (CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS, default
# 120000). Booley's inline wait (240s) and booley_poll ceiling (270s) are
# longer, so a heavy call was backgrounded mid-wait and its notification
# carried only RUNNING. 2h matches MCP_TOOL_TIMEOUT: past every server-side
# wait, so a call is never auto-backgrounded, while Ctrl+B still works (0
# would disable the background wrapper entirely). Claude Code clamps the value
# only to [0, 2^31-1] ms (checked on 2.1.317), so 2h is honored as written.
ENV CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS=7200000

# The stable image must never accidentally acquire candidate application code.
RUN python -c 'import importlib.util; assert importlib.util.find_spec("booley") is None' \
    && yosys -V \
    && iverilog -V \
    && verilator --version \
    && verible-verilog-lint --version

USER root
# Built-in host-provisioned Vivado policy is invariant runtime infrastructure.
COPY src/booley/data/docker/vivado-wrapper /usr/local/bin/vivado
RUN chmod 755 /usr/local/bin/vivado
USER agent

# Pre-create writable dirs for agent CLIs and T3 Code (mounting into a non-existent
# directory would create it as root and prevent agent writes).
RUN mkdir -p /home/agent/.codex /home/agent/.claude /home/agent/.t3

# Resolved package inventory (#829): the final runtime base's installed dpkg
# packages plus exact Python and pip versions. This layer must stay after every
# apt/pip change above. Derived images inherit these bytes unchanged; they never
# regenerate the file or override its label. `python -I` keeps user-site and
# PYTHON* overrides out of the collection.
USER root
COPY src/booley/data/docker/base_package_inventory.py /usr/local/libexec/booley/base_package_inventory.py
RUN install -d -m 0755 -o root -g root /usr/local/libexec/booley /usr/local/share/booley \
    && chown root:root /usr/local/libexec/booley/base_package_inventory.py \
    && chmod 0644 /usr/local/libexec/booley/base_package_inventory.py \
    && python -I /usr/local/libexec/booley/base_package_inventory.py generate \
        --output /usr/local/share/booley/base-package-inventory.json \
    && chmod 0644 /usr/local/share/booley/base-package-inventory.json
USER agent
RUN python -I /usr/local/libexec/booley/base_package_inventory.py validate \
        /usr/local/share/booley/base-package-inventory.json

ARG BOOLEY_BASE_SOURCE_REVISION=unknown
ARG BOOLEY_BASE_CONTRACT=unknown
ARG BOOLEY_BASE_BUILT_AT=unknown
LABEL org.opencontainers.image.source=https://github.com/boldaxolotl/booley \
      org.opencontainers.image.revision=${BOOLEY_BASE_SOURCE_REVISION} \
      org.opencontainers.image.created=${BOOLEY_BASE_BUILT_AT} \
      io.booley.runtime-base.contract=${BOOLEY_BASE_CONTRACT} \
      io.booley.runtime-base.package-inventory=/usr/local/share/booley/base-package-inventory.json \
      io.booley.openroad.source-revision=${OPENROAD_SOURCE_REF} \
      io.booley.openroad.builder-artifact=docker.io/openroad/ubuntu26.04@sha256:c3185708e2f1cdb4fed9fb4d84d2882d36a1f1f6af90959ceb07dcb7416fe49d \
      io.booley.eda.builder-artifact=docker.io/openroad/ubuntu26.04-dev@sha256:a971c4db78c9a4a8db18a9fe136c9731c613e4582a5093180bc7c07e24351e09 \
      io.booley.openroad.runtime-parent-artifact=docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

WORKDIR /work
