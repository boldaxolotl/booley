# Published Booley EDA/runtime base — invariant tools and Python dependencies.
# Candidate application code, B-Wave, and repository patches belong in Dockerfile.
#
# OpenROAD's public Debian channel ended after the 2024-12-14 release. Extract
# the exact 26Q3 binary and Corresponding Source from its official builder, but
# run from the exact dependency image used by upstream's final stage. The
# builder is intentionally throwaway: its object files and regression fixtures
# account for most of the old Session Image.
FROM docker.io/openroad/ubuntu24.04@sha256:c34542dd5c3624117e8370cfb3a4f37a40bfce73a25f5cefdad3277c4c46ce8a AS openroad-artifacts

USER root
ARG OPENROAD_SOURCE_REF=a9147cf3aebe65e058bb3fa89c1f9e524488dbb8
RUN tar --sort=name --mtime='UTC 2026-06-30' --owner=0 --group=0 --numeric-owner \
        --exclude='./build' -C /OpenROAD -czf \
        "/tmp/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" .

FROM docker.io/openroad/ubuntu24.04-dev@sha256:1cfdeba85a28a0bd2a4fca1a5b357fa7f715838941b87a0eeff1686494b1c1db AS eda-artifacts

# Heavy compilers and development packages stay in this throwaway stage. The
# runtime below receives only the installed EDA artifacts.
USER root
WORKDIR /

# Yosys + ABC + native slang frontend, built from source.
#
# Yosys 0.67 replaced the old `make config-gcc` Makefile flow with CMake
# (>=3.28; Ubuntu 24.04 ships 3.28.3). The SystemVerilog `read_slang` frontend
# (povik/sv-elab on top of MikePopoloski/slang) is a git submodule and is
# ENABLED BY DEFAULT — there is no enable flag; slang is built unless
# -DYOSYS_WITHOUT_SLANG=ON is passed. Its C++ deps (fmt/cxxopts/boost_regex)
# are vendored as Yosys submodules, so no extra apt packages beyond the base
# image's flex/bison/libfl-dev (line ~23) plus cmake/gawk here. Submodules are
# fetched full (NOT --shallow-submodules): sv-elab/slang pin non-tip commits a
# shallow submodule fetch can miss.
ARG YOSYS_VERSION=v0.68
ARG YOSYS_REF=38e001a6ff74ca434bf4cc02c053f53619160ab0
RUN echo ">>> Building Yosys ${YOSYS_VERSION} (${YOSYS_REF}) + slang from source (this takes a while)..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        cmake gawk pkg-config tcl-dev libreadline-dev libffi-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/yosys \
    && cd /tmp/yosys \
    && git remote add origin https://github.com/YosysHQ/yosys.git \
    && git -c protocol.version=0 fetch --depth 1 origin "${YOSYS_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${YOSYS_REF}" \
    && git -c protocol.version=0 submodule update --init --recursive \
    && cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_CXX_COMPILER=g++ \
    && cmake --build build --parallel "$(nproc)" \
    && cmake --install build --strip \
    && yosys-abc -c "quit" \
    && yosys -p 'help read_slang' >/dev/null \
    && rm -rf /tmp/yosys

# Icarus Verilog is built from source because Ubuntu packages lag releases.
ARG ICARUS_VERSION=v13_0
ARG ICARUS_REF=dfeee909ed9f20b4870dd93423156c0170c0e1ff
RUN echo ">>> Building Icarus Verilog ${ICARUS_VERSION} (${ICARUS_REF}) from source..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        file gperf libreadline-dev zlib1g-dev libbz2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/iverilog \
    && cd /tmp/iverilog \
    && git remote add origin https://github.com/steveicarus/iverilog.git \
    && git -c protocol.version=0 fetch --depth 1 origin "${ICARUS_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${ICARUS_REF}" \
    && sh autoconf.sh \
    && ./configure --prefix=/usr/local \
    && make -j$(nproc) \
    && make install \
    && find /usr/local/bin/iverilog /usr/local/bin/vvp /usr/local/lib/ivl \
        -type f -exec sh -c 'for artifact do case "$(file -b "$artifact")" in ELF*) strip --strip-unneeded "$artifact";; esac; done' sh {} + \
    && iverilog -V >/dev/null 2>&1 \
    && rm -rf /tmp/iverilog

# Verilator is built from source so host installations do not affect results.
# v5.048 currently trips an internal error elaborating some downstream designs (force + unpacked arrays).
ARG VERILATOR_VERSION=v5.046
ARG VERILATOR_REF=24b2ac24c721fdad89bba75a492e02c6aa63f32e
RUN echo ">>> Building Verilator ${VERILATOR_VERSION} (${VERILATOR_REF}) from source (this takes a while)..." \
    && apt-get update && apt-get install -y --no-install-recommends help2man \
    && rm -rf /var/lib/apt/lists/* \
    && git init /tmp/verilator \
    && cd /tmp/verilator \
    && git remote add origin https://github.com/verilator/verilator.git \
    && git -c protocol.version=0 fetch --depth 1 origin "${VERILATOR_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${VERILATOR_REF}" \
    && autoconf && ./configure --prefix=/usr/local \
    && make -j4 && make install \
    && find /usr/local/bin -maxdepth 1 -type f -name 'verilator*_bin*' \
        -exec strip --strip-unneeded {} + \
    && verilator --version \
    && rm -rf /tmp/verilator

# Minimal Session Runtime. The immutable upstream development image remains the
# EDA builder, but none of its compilers, Docker tooling, Pandoc, LLVM, CMake,
# headers, or build caches become runtime layers.
FROM docker.io/library/ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/Los_Angeles \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

USER root
WORKDIR /

# Tolerate host clock skew during image build (win_test): on Windows hosts the
# Docker Desktop/WSL2 VM inherits the host clock; a skewed host (common on
# dual-boot RTC-vs-UTC setups) makes apt reject freshly-published Release
# files as "not valid yet". Package integrity remains GPG-verified.
RUN printf 'Acquire::Check-Date "false";\n' > /etc/apt/apt.conf.d/99-tolerate-clock-skew

# Development support intentionally stops at the native C/C++ toolchain and
# headers needed by project and Verilator builds. The remaining packages are
# the audited runtime closure for OpenROAD, Yosys, Icarus, Python, and Booley.
RUN echo ">>> Installing minimal runtime dependencies and Python 3.13..." \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates ccache curl file g++ gcc git jq locales make \
        ripgrep software-properties-common time unzip xz-utils \
        libbz2-1.0 libffi8 libgomp1 libpixman-1-0 libpython3.12 \
        libreadline8t64 libtcl8.6 libudev1 libyaml-cpp0.8 tcl tcllib zlib1g \
        libgl1 libopengl0 libqt5charts5 libqt5core5a libqt5gui5 \
        libqt5widgets5 qt5-image-formats-plugins \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.13 python3.13-dev python3.13-venv \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.13 /usr/bin/python3 \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Copy only installed EDA payloads out of the throwaway dependency/build stage.
COPY --from=eda-artifacts /usr/local/bin/yosys* /usr/local/bin/
COPY --from=eda-artifacts /usr/local/share/yosys/ /usr/local/share/yosys/
COPY --from=eda-artifacts /usr/local/bin/iverilog* /usr/local/bin/vvp /usr/local/bin/
COPY --from=eda-artifacts /usr/local/lib/ivl/ /usr/local/lib/ivl/
COPY --from=eda-artifacts /usr/local/include/iverilog/ /usr/local/include/iverilog/
COPY --from=eda-artifacts /usr/local/bin/verilator* /usr/local/bin/
COPY --from=eda-artifacts /usr/local/share/verilator/ /usr/local/share/verilator/
COPY --from=eda-artifacts /usr/local/share/pkgconfig/verilator.pc /usr/local/share/pkgconfig/verilator.pc
COPY --from=eda-artifacts /usr/local/share/man/man1/iverilog* /usr/local/share/man/man1/vvp.1 /usr/local/share/man/man1/
COPY --from=eda-artifacts /usr/local/share/man/man1/verilator* /usr/local/share/man/man1/

# OpenROAD — physical synthesis: placement, buffering/sizing, and estimated
# wire RC. The binary remains byte-identical to the digest-pinned builder. Its
# runtime receives only the OR-Tools library closure, not its 177 MB development
# headers, examples, executables, or CMake metadata.
ARG OPENROAD_VERSION=26Q3
ARG OPENROAD_SOURCE_REF=a9147cf3aebe65e058bb3fa89c1f9e524488dbb8
ARG OPENROAD_BINARY_VERSION=26Q2-2580-ga9147cf3ae
ARG OPENROAD_SOURCE_SENTINEL_SHA256=c8bb060f372392663871afb62ca922f9da1fd58a1b635324da1ec713a88c928f
COPY --from=openroad-artifacts /OpenROAD/build/bin/openroad /usr/bin/openroad
COPY --from=openroad-artifacts /opt/or-tools/lib/ /opt/or-tools/lib/
COPY --from=openroad-artifacts /OpenROAD/LICENSE /usr/local/share/doc/openroad/LICENSE
COPY --from=openroad-artifacts /OpenROAD/src/sta/LICENSE /usr/local/share/doc/openroad/OpenSTA-LICENSE
COPY --from=openroad-artifacts /tmp/OpenROAD-a9147cf3aebe65e058bb3fa89c1f9e524488dbb8.tar.gz /usr/local/share/doc/openroad/OpenROAD-a9147cf3aebe65e058bb3fa89c1f9e524488dbb8.tar.gz
COPY src/booley/data/docker/openroad-source-manifest.json /usr/local/share/doc/openroad/source-manifest.json
RUN echo ">>> Verifying OpenROAD ${OPENROAD_VERSION} (${OPENROAD_SOURCE_REF})..." \
    && test "$(/usr/bin/openroad -version | xargs)" = "${OPENROAD_BINARY_VERSION}" \
    && test "$(tar -xOf "/usr/local/share/doc/openroad/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" \
        ./src/rsz/src/Resizer.tcl | sha256sum | awk '{print $1}')" = \
        "${OPENROAD_SOURCE_SENTINEL_SHA256}" \
    && python3 -c 'import json; manifest=json.load(open("/usr/local/share/doc/openroad/source-manifest.json")); assert manifest["revision"] == "a9147cf3aebe65e058bb3fa89c1f9e524488dbb8"; assert len(manifest["submodules"]) == 5' \
    && test -f /usr/local/share/doc/openroad/LICENSE \
    && test -f /usr/local/share/doc/openroad/OpenSTA-LICENSE \
    && ln -s /usr/bin/openroad /usr/local/bin/openroad \
    && printf '%s\n' \
        "OpenROAD source revision: ${OPENROAD_SOURCE_REF}" \
        "Corresponding Source: /usr/local/share/doc/openroad/OpenROAD-${OPENROAD_SOURCE_REF}.tar.gz" \
        'Recursive source manifest: /usr/local/share/doc/openroad/source-manifest.json' \
        'OpenROAD license: /usr/local/share/doc/openroad/LICENSE' \
        'OpenSTA license: /usr/local/share/doc/openroad/OpenSTA-LICENSE' \
        > /usr/local/share/doc/openroad/BOOLEY-SOURCE.txt \
    && openroad -version \
    && yosys -p 'help read_slang' >/dev/null \
    && iverilog -V >/dev/null 2>&1 \
    && verilator --version >/dev/null

# Worktrees are bind-mounted from the host with different ownership. Identity
# defaults remain neutral; projects override these per worktree.
RUN git config --system --add safe.directory '*' \
    && git config --system user.name "Dev" \
    && git config --system user.email "dev@localhost"

# sv2v (pinned release binary)
ARG SV2V_VERSION=v0.0.13
ARG SV2V_SHA256=552799a1d76cd177b9b4cc63a3e77823a3d2a6eb4ec006569288abeff28e1ff8
RUN echo ">>> Installing sv2v ${SV2V_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/zachjs/sv2v/releases/download/${SV2V_VERSION}/sv2v-Linux.zip" \
    -o /tmp/sv2v.zip \
    && echo "${SV2V_SHA256}  /tmp/sv2v.zip" | sha256sum -c - \
    && unzip -o /tmp/sv2v.zip -d /tmp/sv2v \
    && cp /tmp/sv2v/sv2v-Linux/sv2v /usr/local/bin/sv2v \
    && chmod +x /usr/local/bin/sv2v && rm -rf /tmp/sv2v.zip /tmp/sv2v

# Verible (pinned prebuilt static binary — the sv2v pattern). Bundled
# lint EDA tool for .core lint Targets with flow_options.tool: verible (ADR 0033).
ARG VERIBLE_VERSION=v0.0-4163-g6cce8f19
ARG VERIBLE_SHA256=ddb9c7ea1fe60146ce2fc9f2f2d7a6c0257d08bf51a98dc0ccb4b47b44161bd8
RUN echo ">>> Installing Verible ${VERIBLE_VERSION}..." \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/chipsalliance/verible/releases/download/${VERIBLE_VERSION}/verible-${VERIBLE_VERSION}-linux-static-x86_64.tar.gz" \
    -o /tmp/verible.tar.gz \
    && echo "${VERIBLE_SHA256}  /tmp/verible.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/verible.tar.gz -C /tmp \
    && cp /tmp/verible-${VERIBLE_VERSION}/bin/* /usr/local/bin/ \
    && strip --strip-unneeded /usr/local/bin/verible-* \
    && rm -rf /tmp/verible.tar.gz /tmp/verible-${VERIBLE_VERSION} \
    && verible-verilog-lint --version

# Node.js 24 LTS + agent CLIs. Download exact publisher artifacts and verify
# them before execution; neither a mutable setup script nor semver ranges are
# allowed in the release image.
ARG NODE_VERSION=24.20.0
ARG NODE_SHA256=2f2c0da162318f0de47665410c7c8c2ed3d36c8f3105de4bbc61176c70a7cbf2
COPY src/booley/data/docker/agent-clis-package.json /opt/agent-clis/package.json
COPY src/booley/data/docker/agent-clis-package-lock.json /opt/agent-clis/package-lock.json
RUN echo ">>> Installing Node.js ${NODE_VERSION} and exact agent CLIs..." \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        -o /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && rm -f /tmp/node.tar.xz \
    && apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap \
    && npm ci --prefix /opt/agent-clis --omit=dev --no-audit --no-fund \
    && CLAUDE_GLIBC=/opt/agent-clis/node_modules/@anthropic-ai/claude-code-linux-x64/claude \
    && CLAUDE_ACTIVE=/opt/agent-clis/node_modules/@anthropic-ai/claude-code/bin/claude.exe \
    && CLAUDE_MUSL=/opt/agent-clis/node_modules/@anthropic-ai/claude-code-linux-x64-musl \
    && test "$CLAUDE_GLIBC" -ef "$CLAUDE_ACTIVE" \
    && test -x "$CLAUDE_MUSL/claude" \
    && rm -rf "$CLAUDE_MUSL" \
    && test ! -e "$CLAUDE_MUSL" \
    && ln -s /opt/agent-clis/node_modules/.bin/claude /usr/local/bin/claude \
    && ln -s /opt/agent-clis/node_modules/.bin/codex /usr/local/bin/codex \
    && test "$(claude --version | awk '{print $1}')" = "2.1.259" \
    && test "$(codex --version | awk '{print $2}')" = "0.153.1" \
    && command -v bwrap \
    && rm -rf /var/lib/apt/lists/*

# The container's network namespace is not the whole agent boundary: both
# clients can expose provider-hosted web MCP tools whose requests never originate
# in Docker. Enforce the offline contract in each client's system policy so
# user/project config and full-access modes cannot turn those MCP tools back on.
COPY src/booley/data/docker/codex-requirements.toml /etc/codex/requirements.toml
COPY src/booley/data/docker/claude-managed-settings.json /etc/claude-code/managed-settings.json

# Non-root user for agent execution.
# Pin agent to uid/gid 1000 so it matches the typical first host user on native
# Linux; the base ubuntu:24.04 image already occupies 1000 with its default
# "ubuntu" user, so remove that first. Without this, bind-mounted project files
# (owned by host uid 1000) are unwritable by the container and the MCP server
# fails to create its .interactive_logs dir.
RUN userdel -r ubuntu 2>/dev/null || true \
    && groupadd -g 1000 agent \
    && useradd -m -s /bin/bash -u 1000 -g 1000 agent

# Install the candidate's declared dependencies behind a cache boundary that
# changes only when pyproject.toml changes. The exporter preserves every PEP
# 508 string verbatim, including environment markers, and pip remains the one
# resolver for both this stable layer and ordinary wheel installation.
# Dependencies go system-wide so the booley-pip-local named volume cannot mask
# them at runtime.
#
# claude-agent-sdk ships a private, full-size Claude CLI even though this
# image already installs the normal npm CLI above. The SDK owns executable
# discovery; removing its duplicate makes it fall back to that system CLI.
# This build-time size optimization knowingly depends on the SDK's private
# bundle layout, but production runtime code does not. Remove it in the SAME
# layer that pip creates it; a later-layer deletion would hide the file from
# the merged filesystem without reclaiming any image storage.
COPY pyproject.toml /tmp/booley-build/pyproject.toml
COPY src/booley/data/docker/export_project_dependencies.py /tmp/booley-build/export_project_dependencies.py
RUN python -m ensurepip --default-pip \
    && python /tmp/booley-build/export_project_dependencies.py \
        /tmp/booley-build/pyproject.toml \
        /tmp/booley-build/project-dependencies.txt \
    && python -m pip install --break-system-packages --no-cache-dir --ignore-installed \
        --timeout 120 --retries 10 \
        --requirement /tmp/booley-build/project-dependencies.txt \
    && rm -f /tmp/booley-build/project-dependencies.txt \
    && python -m pip check \
    && CLAUDE_SDK_BUNDLED_CLI="$(python -c 'from pathlib import Path; import claude_agent_sdk; print(Path(claude_agent_sdk.__file__).parent / "_bundled" / "claude")')" \
    && test -x "$(command -v claude)" \
    && test -x "$CLAUDE_SDK_BUNDLED_CLI" \
    && rm -f "$CLAUDE_SDK_BUNDLED_CLI" \
    && test ! -e "$CLAUDE_SDK_BUNDLED_CLI"

# Publisher transfers for numerical and other large wheels can pause long
# enough to exceed pip's 15-second default even while the connection is sound.
# The large invariant SDK install above carries the same explicit policy; this
# inherited setting protects every later base- and candidate-image install.
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

# EDA invocation/registry layer (ADR 0019 + 0022) — pinned EXACTLY to the
# flow-API-stable pair. These also arrive transitively via the wheel's
# dependencies; pinning them explicitly here makes the contract visible in
# the image and guards against a future loosening of the wheel constraint.
# Edalize only *invokes* the EDA tools built above; it does not manage their
# versions (ADR 0019 decision).
RUN python -m pip install --break-system-packages --no-cache-dir \
    "edalize==0.6.8" "fusesoc==2.4.6"

# Cocotb verification layer (ADR 0034 decision 10) — cocotb 2.x plus the
# small curated, pinned Python set a testbench may import (Booley Flows have no
# network, so anything beyond this set is vendored in the project tree).
# cocotbext-spi is ABSENT deliberately: no release imports against cocotb 2.x
# (0.5.0 still uses the removed cocotb.clock.BaseClock).
RUN python -m pip install --break-system-packages --no-cache-dir --ignore-installed \
    "cocotb==2.1.0" "numpy==2.5.2" "cocotbext-axi==0.1.28" "cocotbext-uart==0.1.4"

# Build-time sanity (D2): the image fails to build rather than failing at
# first sim — cocotb-config resolves, the curated set imports, and the
# Icarus VPI library the run-half loads by absolute path exists. Cocotb 2.1
# returns the complete platform-suffixed path (`.so` on this Linux image).
RUN test "$(cocotb-config --version)" = "2.1.0" \
    && python3 -c "import cocotb, cocotbext.axi, cocotbext.uart, numpy" \
    && test -e "$(cocotb-config --lib-name-path vpi icarus)"
USER agent

# Pre-create pip user-install dirs so named volumes inherit agent ownership
RUN mkdir -p /home/agent/.local/lib/python3.13/site-packages /home/agent/.local/bin
ENV PATH="/home/agent/.local/bin:${PATH}"
ENV PYTHONUSERBASE="/home/agent/.local"

# Session Runtime detection (ADR 0028): marks every process in this image — including
# bare `docker exec` sessions, which devcontainer remoteEnv cannot reach —
# as running inside the Booley Session Runtime. /.dockerenv is the fallback
# for containers from images built before this was added.
ENV BOOLEY_CONTAINER=1

# Claude Code kills an MCP tool call at 60s by default (measured on 2.1.205;
# ADR 0027 amendment 2026-07-09). 2h matches the Codex tool_timeout_sec the
# registrar writes. NOTE: the effective ceiling is still ~300s — the client's
# HTTP layer drops a response whose headers haven't arrived by then, and the
# booley server (json_response=True) sends headers only on completion — so
# server-side waits are capped at 270s; this ENV removes the 60s MCP-level
# kill underneath that. Image-level ENV so it reaches every entry path —
# tabs, docker exec, the Ticket-Mode runner — even when a stale devcontainer
# spec predates it.
ENV MCP_TOOL_TIMEOUT=7200000

# The stable image must never accidentally acquire candidate application code.
RUN python -c 'import importlib.util; assert importlib.util.find_spec("booley") is None' \
    && yosys -V \
    && iverilog -V \
    && verilator --version \
    && verible-verilog-lint --version

USER root
# Built-in host-provisioned Vivado policy is invariant runtime infrastructure.
COPY src/booley/data/docker/vivado-wrapper /usr/local/bin/vivado
RUN chmod 755 /usr/local/bin/vivado
USER agent

# Pre-create writable dirs for agent CLIs (bind-mounting individual files into a
# non-existent directory would create it as root and prevent agent writes).
RUN mkdir -p /home/agent/.codex /home/agent/.claude

ARG BOOLEY_BASE_SOURCE_REVISION=unknown
ARG BOOLEY_BASE_CONTRACT=unknown
ARG BOOLEY_BASE_BUILT_AT=unknown
LABEL org.opencontainers.image.source=https://github.com/boldaxolotl/booley \
      org.opencontainers.image.revision=${BOOLEY_BASE_SOURCE_REVISION} \
      org.opencontainers.image.created=${BOOLEY_BASE_BUILT_AT} \
      io.booley.runtime-base.contract=${BOOLEY_BASE_CONTRACT} \
      io.booley.openroad.source-revision=a9147cf3aebe65e058bb3fa89c1f9e524488dbb8 \
      io.booley.openroad.builder-artifact=docker.io/openroad/ubuntu24.04@sha256:c34542dd5c3624117e8370cfb3a4f37a40bfce73a25f5cefdad3277c4c46ce8a \
      io.booley.eda.builder-artifact=docker.io/openroad/ubuntu24.04-dev@sha256:1cfdeba85a28a0bd2a4fca1a5b357fa7f715838941b87a0eeff1686494b1c1db \
      io.booley.openroad.runtime-parent-artifact=docker.io/library/ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

WORKDIR /work
