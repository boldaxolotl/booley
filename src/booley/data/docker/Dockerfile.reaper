# Booley Interactive Mode idle reaper (ADR 0018).
# The only container that mounts the docker socket; stops idle
# Sandboxes. Build context: src/booley/docker (repo-root .dockerignore
# strips src/).
FROM docker:29.9.3-cli@sha256:2357639ad1ea7d0194134bf3292622fd4e562483966ed674e5d7c945b5f3b28d AS docker-cli

FROM python:3.15.2-alpine3.24@sha256:0f9552bb28711333da16915ec146f5e6bb44a7fdac9ced15dc17c2e0206346dd
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY reaper.py /app/reaper.py
WORKDIR /app
ENTRYPOINT ["python3", "-u", "reaper.py"]
