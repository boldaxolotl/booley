# Booley Interactive Mode idle reaper (ADR 0018).
# The only container that mounts the docker socket; stops idle/over-cap
# session containers. Build context: src/booley/docker (repo-root .dockerignore
# strips src/).
FROM docker:29.6.2-cli@sha256:be132a9f282288de4afaf63379dff75711fda0147c6b72a9df44e51841402144 AS docker-cli

FROM python:3.13.14-alpine3.24@sha256:399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY reaper.py /app/reaper.py
WORKDIR /app
ENTRYPOINT ["python3", "-u", "reaper.py"]
