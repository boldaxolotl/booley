# Booley Interactive Mode idle reaper (ADR 0018).
# The only container that mounts the docker socket; stops idle
# Sandboxes. Build context: src/booley/docker (repo-root .dockerignore
# strips src/).
FROM docker:29.8.2-cli@sha256:b1805116a6a86cc591b5d5f60a910a0715cdcc9d18d866ad68b1457ead25c35c AS docker-cli

FROM python:3.14.8-alpine3.24@sha256:8acac70227ce3b34da9453120c375cc5b66cd0b062d4dc6bc74286f81a3819e1
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY reaper.py /app/reaper.py
WORKDIR /app
ENTRYPOINT ["python3", "-u", "reaper.py"]
