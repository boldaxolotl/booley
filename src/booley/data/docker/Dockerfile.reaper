# Booley Interactive Mode idle reaper (ADR 0018).
# The only container that mounts the docker socket; stops idle/over-cap
# session containers. Build context: src/booley/docker (repo-root .dockerignore
# strips src/).
FROM docker:29.7.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe AS docker-cli

FROM python:3.14.7-alpine3.24@sha256:05b2b8b732ecd268fee8727a369f936f022d1321b59befd13c30ede22769dcdc
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY reaper.py /app/reaper.py
WORKDIR /app
ENTRYPOINT ["python3", "-u", "reaper.py"]
