# Booley Interactive Mode idle reaper (ADR 0018).
# The only container that mounts the docker socket; stops idle/over-cap
# session containers. Build context: src/booley/docker (repo-root .dockerignore
# strips src/).
FROM docker:29.8.0-cli@sha256:eccaacfeed644c7de222ff047483568cb988dde95476fbaaf10ea2d04921bb66 AS docker-cli

FROM python:3.14.7-alpine3.24@sha256:c6ead215bfd31f1e433d968853b7a769989117115b728874824e6c0a27cb96fc
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY reaper.py /app/reaper.py
WORKDIR /app
ENTRYPOINT ["python3", "-u", "reaper.py"]
