# Python caches
__pycache__/
*.pyc
.pytest_cache/
/.ruff_cache/

# Local Python environment and coverage outputs
/.venv/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/

# Editable install metadata
src/*.egg-info/
# Generated by docker/build.sh just before the wheel build: stamps the
# source commit into the package so a wheel install can report it (F-5).
src/booley/_build_commit.py

# Rust bwave tool
crates/bwave/target/
crates/bwave/test_vcds/
# Scratch VCDs at the crate root are ignored; tracked fixtures live in tests/fixtures/.
crates/bwave/*.vcd
*.fst
*.vcd.idx
*.vcd.col
crates/bwave/tests/fixtures/scaling_*.vcd
crates/bwave/tests/perf_latest.json
crates/bwave/tests/perf_real_latest.json
crates/bwave/tests/perf_real_baseline.json

# Runtime directories (created by booley init)
/worktrees/
/tmp/

# Mutation testing cache and one-off helper scripts
/mutants/
src/.mutmut-results*.json
src/_mutmut_check.py
src/_run_wave*.py
src/_test_one_mutant.py

# Agent temp scripts (tmp/ is gitignored above)

# Build/dist artifacts
build/
dist/

# Legacy project dir (migrated to .booley_project/)
/project/

# Agent artifacts
/util/
/.booley_codex_config.toml

# Personal agent, editor, and media workspaces
/.agents/
/.vscode/
/videos/

# Local test scratch (pip --target deps, fusesoc wrapper, fixture project)
/.runtime/
!crates/bwave/tests/fixtures/native_verilator_counter.fst

# This committed fixture must override user-global `.booley_project/` ignores.
!/tests/fixtures/cocotb_counter/.booley_project/
!/tests/fixtures/cocotb_counter/.booley_project/**
!/tests/fixtures/ticket_mode_smoke/.booley_project/
!/tests/fixtures/ticket_mode_smoke/.booley_project/**

# Native bwave binary — built by CI into the wheel's package data (and by the
# sandbox image build into the installed package). Never committed.
src/booley/data/bin/

# Internal planning docs — not for distribution by default.
docs/adr/
docs/plans/
docs/notes/
